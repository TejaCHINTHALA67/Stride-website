---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HexField from '../components/HexField.astro';
import CookieConsent from '../components/CookieConsent.astro';

export interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
}
const {
  title = 'Terrarun — Run & Own Your City | Territory Running Game',
  description = 'Terrarun turns running into a turf war. Run a loop, claim the real area you enclose, and steal rivals’ territory on a live 3D map. Free on iPhone and Android.',
  path = '/',
  noindex = false,
} = Astro.props;

const site = 'https://striderunning.run';
// Always canonicalise to a trailing-slash URL so the canonical tag matches the
// URL Cloudflare Pages actually serves (it 308s /terms → /terms/). A mismatch
// is what made GSC file these pages under "Alternative page with proper
// canonical tag" instead of indexing them directly.
const normalizedPath = path.endsWith('/') ? path : `${path}/`;
const canonical = new URL(normalizedPath, site).href;
const ogImage = `${site}/images/og.png`;
const keywords = 'Terrarun, Terrarun running, Terrarun run, Terrarun game, Terrarun play, best running app, running app, GPS running app, run tracker app, fitness app, Strava alternative, competitive running app, territory running game, running game, GPS running game, run and own your city, claim territory running, turf running, run tracker game, iOS running game, gamified running app, running game iPhone';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    // brand-variant resolution: helps "stride running", "stride run",
    // "stride play game" queries land on this site.
    {
      '@type': 'WebSite',
      name: 'Terrarun',
      alternateName: ['Terrarun Running', 'Terrarun Run', 'Terrarun Game', 'Terrarun Play', 'Terrarun — Run & Own Your City'],
      url: site,
    },
    {
      '@type': 'Organization',
      name: 'Terrarun',
      alternateName: 'Terrarun Running',
      url: site,
      logo: `${site}/stride-logo.png`,
      email: 'hello@striderunning.run',
      sameAs: [],
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Terrarun — Run & Own Your City',
      alternateName: ['Terrarun', 'Terrarun Running', 'Terrarun Game'],
      operatingSystem: 'iOS, Android',
      applicationCategory: 'HealthApplication',
      applicationSubCategory: 'Running Game',
      genre: 'Fitness Game',
      keywords,
      url: site,
      installUrl: [
        'https://apps.apple.com/us/app/conquer-your-city-stride/id6776885395',
        'https://play.google.com/store/apps/details?id=com.teja.stride',
      ],
      downloadUrl: [
        'https://apps.apple.com/us/app/conquer-your-city-stride/id6776885395',
        'https://play.google.com/store/apps/details?id=com.teja.stride',
      ],
      description,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
  ],
};
---

<!doctype html>
<html lang="en" class="bg-canvas">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonical} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}
    <meta name="theme-color" content="#E7ECEA" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Terrarun" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Terrarun — Run a loop. Own the block." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Terrarun — Run a loop. Own the block." />

    <!-- Fonts: Clash Display (app display font) + Satoshi (body) -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600,700&f[]=satoshi@400,500,700&display=swap"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/stride-logo.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <!-- LLM-readable site summary for AI assistants / answer engines -->
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="llms.txt" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- ⚠️ THE PLATFORM STAMP HAS TO LAND BEFORE THE FIRST PAINT. It decides
         which store badge sits first in every CTA row on the page; set from a
         deferred script it would reorder the buttons under a thumb already on
         its way to one. Blocking, in the head, four lines, no dependency.
         iPadOS reports itself as a Macintosh, so the touch-point test is not
         optional. -->
    <script is:inline>
      (function () {
        var ua = navigator.userAgent || '';
        var p = /Android/i.test(ua) ? 'android'
          : (/iPhone|iPad|iPod/i.test(ua) || (/Macintosh/.test(ua) && (navigator.maxTouchPoints || 0) > 1)) ? 'ios'
          : 'other';
        document.documentElement.setAttribute('data-platform', p);
      })();
    </script>
  </head>
  <body>
    <HexField />
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieConsent />

    <!-- ⚠️ THE PAGEVIEW IS GATED, NOT DEFERRED. `track()` returns without
         sending when consent is absent, so this runs on every page and does
         nothing at all until someone has said yes. -->
    <script>
      import { pageview } from '../lib/analytics';
      pageview();
    </script>

    <!-- on-scroll reveals (vanilla, respects reduced motion)

         WARNING: `.reveal` IS `opacity: 0` IN CSS, SO EVERY SECTION OF THIS SITE
         IS INVISIBLE UNTIL JAVASCRIPT SAYS OTHERWISE. That is a nice effect and
         a bad failure mode: anything that stops this script leaves a blank white
         page, which is exactly what gets reported. Two guards below, both of
         which exist because of a real way it breaks:

         1. THRESHOLD 0, NOT 0.14. A threshold is a fraction of the ELEMENT's own
            area, so a section taller than about 7 viewports can never reach 14%
            however far you scroll, and stays blank forever. Firing on the top
            edge crossing 88% of the viewport is height-independent and looks the
            same on everything that does work today.

         2. A SWEEP. IntersectionObserver delivers nothing while a tab is hidden,
            so a page opened in a background tab starts blank; normally the
            callbacks arrive on focus, but a throttled or restored tab does not
            always get them. The sweep reveals anything already on screen when
            the page becomes visible and once shortly after load. It only touches
            elements in view, so the scroll effect further down is preserved. -->
    <script is:inline>
      (() => {
        const els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          els.forEach((e) => e.classList.add('in'));
          return;
        }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
        }, { threshold: 0, rootMargin: '0px 0px -12% 0px' });
        els.forEach((e) => io.observe(e));

        const sweep = () => {
          document.querySelectorAll('.reveal:not(.in)').forEach((e) => {
            const r = e.getBoundingClientRect();
            if (r.top < innerHeight && r.bottom > 0) { e.classList.add('in'); io.unobserve(e); }
          });
        };
        addEventListener('visibilitychange', () => { if (!document.hidden) sweep(); });
        setTimeout(sweep, 1200);
      })();
    </script>
  </body>
</html>
