# Copy to .env (local) or set in Cloudflare Pages → Settings → Environment variables.
# The anon key is the PUBLIC key from your Supabase project (safe in the browser).
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
PUBLIC_MAPBOX_TOKEN=your-public-mapbox-token

# Paddle.js uses a publishable client-side token, never a server API key.
# test_* pairs with sandbox; live_* pairs with production. The build refuses a
# mismatched token/environment or duplicate/malformed price IDs.
PUBLIC_PADDLE_ENV=sandbox
PUBLIC_PADDLE_TOKEN=test_your-client-side-token
PUBLIC_PADDLE_PRICE_MONTHLY=pri_your-monthly-price-id
PUBLIC_PADDLE_PRICE_YEARLY=pri_your-yearly-price-id

# PostHog — the SAME project the app uses, so a web signup and an app run are one
# person. Publishable key (phc_), safe in the browser. Analytics only fires after
# the visitor accepts; without these the site simply measures nothing.
PUBLIC_POSTHOG_KEY=phc_your-project-key
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
