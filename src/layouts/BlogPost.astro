---
import Layout from './Layout.astro';
import AppStore from '../components/AppStore.astro';

export interface Props {
  title: string;
  description: string;
  path: string;
  published: string;
  updated?: string;
  tag: string;
  readTime: string;
  faqs?: { q: string; a: string }[];
  related?: { href: string; label: string };
}
const { title, description, path, published, updated = published, tag, readTime, faqs = [], related } = Astro.props;
const url = `https://striderunning.run${path.endsWith('/') ? path : path + '/'}`;

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: title,
      description,
      datePublished: published,
      dateModified: updated,
      author: { '@type': 'Organization', name: 'Terrarun' },
      publisher: {
        '@type': 'Organization',
        name: 'Terrarun',
        logo: { '@type': 'ImageObject', url: 'https://striderunning.run/stride-logo.png' },
      },
      mainEntityOfPage: url,
    },
    ...(faqs.length
      ? [{
          '@type': 'FAQPage',
          mainEntity: faqs.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        }]
      : []),
  ],
};
const dateLabel = new Date(updated).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title={title} description={description} path={path}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />

  <article class="article mx-auto max-w-3xl px-5 pt-32 pb-20">
    <a href="/blog/" class="text-sm text-ink-faint transition hover:text-mint">← Terrarun blog</a>
    <p class="mt-6 font-mono text-xs uppercase tracking-[0.25em] text-mint">{tag}</p>
    <h1 class="mt-3 font-display text-4xl font-bold leading-[1.08] tracking-tight sm:text-5xl">{title}</h1>
    <p class="mt-4 font-mono text-xs uppercase tracking-widest text-ink-faint">Updated · {dateLabel} · {readTime} read</p>

    <div class="prose mt-10 space-y-5 text-[15px] leading-relaxed text-ink-soft">
      <slot />
    </div>

    {faqs.length > 0 && (
      <div class="mt-12">
        <h2 class="font-display text-2xl font-semibold text-ink">Frequently asked questions</h2>
        <div class="mt-5 space-y-3">
          {faqs.map((f) => (
            <details class="glass group rounded-2xl p-5">
              <summary class="cursor-pointer list-none font-display text-base font-semibold text-ink">{f.q}</summary>
              <p class="mt-3 text-sm leading-relaxed text-ink-soft">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    )}

    <div class="glass glass-mint mt-12 rounded-3xl px-6 py-10 text-center">
      <h2 class="font-display text-2xl font-bold sm:text-3xl">Turn your runs into a game.</h2>
      <p class="mx-auto mt-3 max-w-lg text-ink-soft">
        Terrarun is live on iPhone — a GPS run tracker where every loop claims real territory.
        Download it free and claim your neighbourhood before anyone else.
      </p>
      <div class="mt-7 flex justify-center"><AppStore compact={true} /></div>
    </div>

    {related && (
      <p class="mt-10 text-sm text-ink-faint">
        Related: <a href={related.href} class="text-mint hover:underline">{related.label} →</a>
      </p>
    )}
  </article>
</Layout>

<style is:global>
  .article .prose h2 { @apply font-display text-2xl font-semibold text-ink mt-9 mb-1; }
  .article .prose h3 { @apply font-display text-lg font-semibold text-ink mt-6 mb-1; }
  .article .prose p { @apply text-ink-soft; }
  .article .prose ul { @apply list-disc space-y-1.5 pl-5 text-ink-soft; }
  .article .prose ol { @apply list-decimal space-y-1.5 pl-5 text-ink-soft; }
  .article .prose a { @apply text-mint hover:underline; }
  .article .prose strong { @apply text-ink; }
  .article details summary::-webkit-details-marker { display: none; }
</style>
