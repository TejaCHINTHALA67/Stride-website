---
import Layout from '../../layouts/Layout.astro';
import { cities } from '../../data/cities';

const title = 'Run & Own Your City — Pick Yours | Stride';
const description =
  'Stride turns running into a territory game in your city. Pick your city to see the best places to run and claim your streets first. Free for iOS — join the waitlist.';

// group cities by country for a tidy directory
const byCountry = cities.reduce((acc, c) => {
  (acc[c.country] ||= []).push(c);
  return acc;
}, {} as Record<string, typeof cities>);
const countries = Object.keys(byCountry).sort();
---

<Layout title={title} description={description} path="/run">
  <section class="mx-auto max-w-4xl px-5 pt-32 pb-10 text-center sm:pt-36">
    <a href="/" class="text-sm text-ink-faint transition hover:text-mint">← Stride home</a>
    <h1 class="mt-6 font-display text-4xl font-bold tracking-tight sm:text-5xl">
      Run &amp; own <span class="text-gradient">your city</span>.
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-ink-soft">
      Pick your city to see the best places to run — and claim your streets before anyone else.
    </p>
  </section>

  <section class="mx-auto max-w-4xl px-5 pb-24">
    {countries.map((country) => (
      <div class="reveal mt-10 first:mt-0">
        <h2 class="font-mono text-xs uppercase tracking-widest text-ink-faint">{country}</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {byCountry[country].map((c) => (
            <a href={`/run/${c.slug}/`} class="glass group flex items-center justify-between rounded-2xl px-5 py-4 transition hover:border-mint/40">
              <span class="font-display text-lg font-semibold transition group-hover:text-mint">{c.name}</span>
              <span class="text-ink-faint transition group-hover:text-mint">→</span>
            </a>
          ))}
        </div>
      </div>
    ))}
    <p class="mt-12 text-center text-sm text-ink-faint">
      Don’t see your city? It’s still unclaimed — <a href="/#waitlist" class="text-mint hover:underline">join the waitlist</a> and play anywhere.
    </p>
  </section>
</Layout>
