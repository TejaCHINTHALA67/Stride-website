            var dp = f.resolvedOptions().maximumFractionDigits;
            var per = document.querySelector('[data-permonth]');
            if (per) per.textContent = f.format(raw.yearly / 12 / Math.pow(10, dp)) + ' a month';
          } catch (e) { /* an unknown currency code just leaves the line empty */ }
        }
        // Paddle echoes the address it geolocated, and lists what can pay there.
        var addr = res.data.address || {};
        renderBilling(addr.countryCode || window.__trCountry, res.data.availablePaymentMethods);
      }

      // `countryCode` omitted → Paddle geolocates by IP, which is the first load.
      function loadPrices(countryCode) {
        var req = { items: [{ priceId: PRICE_MONTHLY, quantity: 1 }, { priceId: PRICE_YEARLY, quantity: 1 }] };
        if (countryCode) req.address = { countryCode: countryCode };
        document.querySelectorAll('[data-price]').forEach(function (el) { el.textContent = '…'; });
        return window.Paddle.PricePreview(req).then(applyPreview);
      }

      var s = document.createElement('script');
      s.src = 'https://cdn.paddle.com/paddle/v2/paddle.js';
      s.onload = function () {
        if (PADDLE_ENV !== 'production') window.Paddle.Environment.set(PADDLE_ENV);
        window.Paddle.Initialize({
          token: PADDLE_TOKEN,
          eventCallback: function (event) {
            if (!event || !event.name) return;
            switch (event.name) {
              case 'checkout.loaded':
                // Paddle now owns the screen; our own status line would only be
                // a second thing talking over it.
                hide();
                break;
              case 'checkout.completed':
                if (window.__trTrack) window.__trTrack('web_paid');
                say('Payment approved.', 'Unlocking Pro on your account…', true);
                break;
              case 'checkout.closed':
                // Abandoned INSIDE Paddle's own overlay — invisible to every
                // other measurement we have, and the biggest single drop in any
                // checkout funnel.
                if (window.__trTrack) window.__trTrack('web_checkout_abandoned');
                hide();
                break;
              case 'checkout.payment.failed':
                if (window.__trTrack) window.__trTrack('web_payment_failed');
                say('That payment did not go through.', 'Nothing was charged. Try another card or payment method.', false);
                break;
              case 'checkout.error':
              case 'checkout.payment.error':
                say('Checkout hit a problem.', 'Nothing was charged. Please try again or email support@striderunning.run.', false);
                break;
            }
          },
        });

        // ⚠️ THE SEAM THE ACCOUNT STEP CALLS. Registered before the first preview
        // so a country chosen while Paddle was still loading is not stranded on
        // whatever the browser locale guessed.
        window.__trReprice = function (code) {
          if (window.__trTrack) window.__trTrack('web_country_changed', { country: code });
          loadPrices(code).catch(function () {
            disablePlans('Prices could not be loaded for that country. Nothing can be charged — pick another, or reload.');
          });
        };

        // Prices come from Paddle, localised to the visitor. Never from markup.
        // ⚠️ A country already chosen on the account step OUTRANKS Paddle's IP
        // guess and must be the one this preview asks about — otherwise the very
        // first preview comes back in the wrong currency and, because
        // `renderBilling` reports 'detect' and a touched country ignores it, the
        // label and the price would then disagree.
        loadPrices(window.__trCountryTouched ? window.__trCountry : null).catch(function () {
          disablePlans('Paddle could not load this build’s prices, so checkout is disabled and nothing can be charged. The free game is unaffected.');
        });
      };
      s.onerror = function () {
        disablePlans('Secure checkout could not load — check your connection or content blocker. The free game is unaffected.');
      };
      document.head.appendChild(s);
    })();
  </script>
)}
