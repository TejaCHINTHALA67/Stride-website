---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Lost your turf? — Terrarun" description="Page not found." path="/404" noindex={true}>
  <section class="mx-auto flex min-h-[70vh] max-w-xl flex-col items-center justify-center px-5 text-center">
    <div class="font-mono text-xs uppercase tracking-[0.3em] text-mint">404</div>
    <h1 class="mt-4 font-display text-5xl font-bold tracking-tight">This block isn’t on the map.</h1>
    <p class="mt-4 text-ink-soft">The page you’re after doesn’t exist — go claim something that does.</p>
    <a href="/" class="btn-primary mt-8">Back to Terrarun</a>
  </section>
</Layout>
