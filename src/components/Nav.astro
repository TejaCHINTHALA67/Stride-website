---
const links = [
  { href: '/#how', label: 'How it works' },
  { href: '/#screens', label: 'Screens' },
  { href: '/#game', label: 'The game' },
  { href: '/#faq', label: 'FAQ' },
  // Reachable in one click for anyone who came looking, and for the Android
  // runners the app sends here to remove ads — but never the hero's ask.
  { href: '/pricing/', label: 'Pricing' },
];
---
<header class="fixed inset-x-0 top-0 z-50">
  <nav class="mx-auto mt-3 flex max-w-6xl items-center justify-between gap-4 rounded-2xl glass px-4 py-2.5 sm:px-5">
    <a href="/" class="flex items-center gap-2.5" aria-label="Terrarun home">
      <img src="/stride-logo.png" alt="Terrarun" width="36" height="36" class="h-9 w-9 rounded-lg" />
      <span class="font-display text-lg font-semibold tracking-tight">Terrarun</span>
    </a>
    <div class="hidden items-center gap-7 md:flex">
      {links.map((l) => (
        <a href={l.href} class="text-sm text-ink-soft transition hover:text-ink">{l.label}</a>
      ))}
    </div>
    <a href="https://apps.apple.com/us/app/conquer-your-city-stride/id6776885395" target="_blank" rel="noopener" class="rounded-xl bg-mint px-4 py-2 text-sm font-semibold text-[#04231B] transition hover:shadow-glow">
      Download
    </a>
  </nav>
</header>
