# Deep-link paths render the app-open fallback page (200 rewrite keeps the URL).
# iPhones WITH Stride installed never hit these — universal links intercept.
/e/* /go.html 200
/c/* /go.html 200
/u/* /go.html 200
/r/* /go.html 200
/x/* /competition/ 200
# ⚠️ Workers assets turn a 200 rewrite into a 307, which DROPS the path — so the code
# travels as a query parameter and invite.html reads that first.
/i/* /invite.html?code=:splat 200
