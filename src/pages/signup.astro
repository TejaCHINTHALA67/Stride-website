---
/**
 * /signup — the web funnel, end to end, on ONE page.
 *
 *   1. Account   →   2. How it works   →   3. Plan   →   4. Get the app
 *
 * ⚠️ THE TUTORIAL IS STEP 2 BECAUSE PAYMENT IS NOT PART OF CREATING AN ACCOUNT.
 * The old shape put the price directly after the form, so somebody who arrived
 * from an ad was asked to pay for a mechanic nobody had shown them. The app
 * learned this exact lesson the expensive way — 1.7 walled runners before their
 * first run and activation fell 56% → 5% — and the web version of "let them run
 * first" is to let them SEE a loop claim ground, on real streets, before the
 * offer. The account step now takes an account and nothing else.
 *
 * ⚠️ THIS IS THE ONLY DOOR TO A PRO PURCHASE. Google Play forbids the Android app
 * from leading users to any payment method other than Play Billing, so Pro cannot
 * be sold in the app at all. It is sold here, and the account carries the
 * entitlement to whatever device signs in.
 *
 * ⚠️ WHY THE PLAN STEP LIVES HERE AND NOT AT /pricing. Signup used to redirect to
 * the pricing page, and that was reverted for a good reason — a price sheet is a
 * marketing page, it has a nav, it loses the funnel, and landing on it cold reads
 * as a toll gate. But removing the money step entirely left the site's one
 * revenue path unreachable from its own front door. So the step is here, inside
 * the flow, with the progress bar still on screen and a real free door under it:
 * a recommendation, never a wall. Nobody navigates; nothing can bounce.
 *
 * ⚠️ IT COLLECTS EXACTLY WHAT THE APP WOULD HAVE ASKED FOR: name and colour. It
 * deliberately does NOT set `onboarded_at`, so the app still runs the tutorial —
 * that is where somebody learns the game, and skipping it for the people who paid
 * would be exactly backwards.
 *
 * ⚠️ Email confirmation is OFF on this project (`mailer_autoconfirm: true`), so
 * signup returns a session immediately and the flow can continue into checkout
 * without a round trip through an inbox. `account.ts` says the true thing if that
 * ever changes rather than failing halfway.
 */
import Layout from '../layouts/Layout.astro';
import AppStore from '../components/AppStore.astro';
import GameTutorial from '../components/GameTutorial.astro';
import { PALETTE } from '../lib/account';

/**
 * ⚠️ `.trim()` ON EVERY ONE, AND IT IS NOT DEFENSIVE PROGRAMMING FOR ITS OWN
 * SAKE. These values are pasted by a human into a Cloudflare dashboard field,
 * and on 2026-09-03 the live site rendered
 * `data-checkout="pri_01m1gaapfrhydp3kwebssdh7df "` — a real trailing space that
 * came straight through the build and into the markup. A trailing space happens
 * to survive `.startsWith()`, so the price ids passed validation; a LEADING one
 * would have failed it silently and disabled checkout with no error anywhere,
 * and a trailing space in the token is handed to `Paddle.Initialize` verbatim.
 * The whole failure mode of this file is silence, so normalise at the boundary.
 */
const PADDLE_TOKEN = (import.meta.env.PUBLIC_PADDLE_TOKEN ?? '').trim();
const PADDLE_ENV = (import.meta.env.PUBLIC_PADDLE_ENV ?? 'sandbox').trim();
const PRICE_MONTHLY = (import.meta.env.PUBLIC_PADDLE_PRICE_MONTHLY ?? '').trim();
const PRICE_YEARLY = (import.meta.env.PUBLIC_PADDLE_PRICE_YEARLY ?? '').trim();

/** ⚠️ A LIVE TOKEN AGAINST SANDBOX PRICES TAKES NO MONEY AND REPORTS NO ERROR.
 *  Every mismatch that can silently sell nothing is checked here, at build time,
 *  and a failure disables checkout rather than rendering a button that cannot
 *  charge. */
const paddleReady = Boolean(
  PADDLE_TOKEN
  && (PADDLE_ENV === 'sandbox' || PADDLE_ENV === 'production')
  && (PADDLE_ENV === 'production' ? PADDLE_TOKEN.startsWith('live_') : PADDLE_TOKEN.startsWith('test_'))
  && PRICE_MONTHLY.startsWith('pri_')
  && PRICE_YEARLY.startsWith('pri_')
  && PRICE_MONTHLY !== PRICE_YEARLY,
);

const proIncludes = [
  'Every metre you claim keeps counting',
  'The full leaderboards, not the top five',
  'Route planner, clubs, events and races',
  'Deep analytics and Apple Watch',
  'No ads on Android',
];
---

<Layout
  title="Create your account — Terrarun"
  description="Create your Terrarun account, pick the colour the city will know you by, and start claiming ground."
  path="/signup"
  noindex={true}
>
  <section class="mx-auto max-w-lg px-5 pt-28 pb-24">
    <a href="/" class="text-sm text-ink-faint hover:text-band-mid">← Back</a>

    {/* ⚠️ A FUNNEL HAS TO SAY WHERE YOU ARE AND WHERE IT ENDS. Without it this
        page reads as an unbounded form on a site that had, a moment ago, been
        free — and "how much more of this is there" is the question that loses
        people on step one. Four steps, all named, so the shape of the
        commitment is visible before it is made. The nodes are driven by
        `data-step` rather than duplicated once per pane.

        ⚠️ THE LABELS ARE ONLY EVER ADDED TO, NEVER SHUFFLED. `setStep` counts
        `STEPS` and fills `data-line="n"` for every n < step, so a fifth step
        needs one node, one line and no JavaScript change — but a node without
        its matching line, or a count that disagrees with the markup, throws on
        the non-null assertion and takes the whole funnel with it. */}
    <ol id="su-progress" data-step="1" class="funnel-progress mt-6 flex items-center gap-2.5" aria-label="Progress: step 1 of 4">
      <li class="flex items-center gap-2.5">
        <span class="progress-node is-current" data-node="1">1</span>
        <span class="text-sm font-semibold text-ink" data-label="1">Account</span>
      </li>
      <li aria-hidden="true" class="progress-line" data-line="1"></li>
      <li class="flex items-center gap-2.5">
        <span class="progress-node" data-node="2">2</span>
        <span class="text-sm text-ink-faint" data-label="2">How it works</span>
      </li>
      <li aria-hidden="true" class="progress-line" data-line="2"></li>
      <li class="flex items-center gap-2.5">
        <span class="progress-node" data-node="3">3</span>
        <span class="text-sm text-ink-faint" data-label="3">Plan</span>
      </li>
      <li aria-hidden="true" class="progress-line" data-line="3"></li>
      <li class="flex items-center gap-2.5">
        <span class="progress-node" data-node="4">4</span>
        <span class="text-sm text-ink-faint" data-label="4">Get the app</span>
      </li>
    </ol>

    <!-- ══════════════ STEP 1 · ACCOUNT ══════════════ -->
    <div id="pane-account" class="funnel-pane">
      <h1 class="mt-6 font-display text-4xl font-bold leading-[1.05] tracking-tight">
        Claim your <span class="text-gradient">name</span>.
      </h1>
      <p class="mt-4 text-[15px] leading-relaxed text-ink-soft">
        One account works everywhere — the website, iPhone and Android. Take about a minute,
        then the whole map is yours to run at.
      </p>

      <form id="signup-form" class="glass mt-6 space-y-5 p-6" novalidate
        data-price-monthly={PRICE_MONTHLY} data-price-yearly={PRICE_YEARLY}>
        <div>
          <label for="su-email" class="block text-sm font-semibold text-ink">Email</label>
          <input id="su-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254"
            class="well mt-2 w-full px-4 py-3 text-[15px] text-ink outline-none placeholder:text-ink-faint"
            placeholder="you@example.com" />
        </div>

        <div>
          <label for="su-pass" class="block text-sm font-semibold text-ink">Password</label>
          <input id="su-pass" name="password" type="password" autocomplete="new-password" required minlength="8" maxlength="128"
            class="well mt-2 w-full px-4 py-3 text-[15px] text-ink outline-none placeholder:text-ink-faint"
            placeholder="At least 8 characters" />
        </div>

        <div id="su-name-field">
          <label for="su-name" class="block text-sm font-semibold text-ink">Runner name</label>
          <input id="su-name" name="username" type="text" autocomplete="username" required minlength="3" maxlength="20"
            class="well mt-2 w-full px-4 py-3 font-mono text-[15px] text-ink outline-none placeholder:text-ink-faint"
            placeholder="lowercase, numbers, _" />
          <p id="su-name-hint" class="mt-2 text-xs text-ink-faint">3–20 characters. This is how the city will know you.</p>
        </div>

        <div id="su-colour-field">
          <span class="block text-sm font-semibold text-ink">Your colour</span>
          <p class="mt-1 text-xs text-ink-faint">Every metre you claim is drawn in it, for everyone.</p>
          <div id="su-colors" class="mt-3 grid grid-cols-6 gap-2.5">
            {PALETTE.map((c, i) => (
              <button type="button" data-color={c} aria-label={`Colour ${i + 1}`}
                class="su-swatch h-10 rounded-xl transition"
                style={`background:${c}`}></button>
            ))}
          </div>
        </div>

        {/* ⚠️ THE COUNTRY IS ASKED HERE, AND IT IS NOT A BILLING QUESTION YET.
            It picks the city the next step's map flies to, and it is the country
            Paddle prices in — one answer doing two jobs, which is why it can sit
            on a page that takes no payment without reading as a payment field.

            It is PRE-FILLED, never blank: the browser's own locale seeds it
            immediately and Paddle's geolocation corrects it the moment the price
            preview lands — but only while nobody has touched the control, or a
            late network answer would overwrite a deliberate choice. */}
        <div id="su-country-field">
          <label for="su-country" class="block text-sm font-semibold text-ink">Country</label>
          <p class="mt-1 text-xs text-ink-faint">Sets your currency and the ways you can pay.</p>
          <select id="su-country" name="country" autocomplete="country"
            class="well mt-3 w-full px-4 py-3 text-[15px] text-ink outline-none">
            <option value="">Detecting…</option>
          </select>
        </div>

        <p id="su-error" class="hidden rounded-xl px-4 py-3 text-sm" role="alert" aria-live="assertive" style="background:rgba(229,72,77,0.10);color:#A3282C"></p>

        <button id="su-submit" type="submit" class="btn-primary w-full">Create account</button>

        <p class="text-center text-xs leading-relaxed text-ink-faint">
          By creating an account you agree to our <a class="font-medium text-band-mid hover:underline" href="/terms/">Terms</a>
          and <a class="font-medium text-band-mid hover:underline" href="/privacy/">Privacy Policy</a>.
        </p>
      </form>

      <p class="mt-6 text-center text-sm text-ink-soft">
        Already have an account?
        <button id="su-signin" class="font-semibold text-band-mid hover:underline">Sign in instead</button>
      </p>

      <div class="mt-7 grid grid-cols-3 gap-2 text-center text-[11px] leading-tight text-ink-faint" aria-label="Account safeguards">
        <span>Encrypted connection</span><span>One account across devices</span><span>Delete your account any time</span>
      </div>
    </div>

    <!-- ══════════════ STEP 2 · HOW IT WORKS ══════════════
         ⚠️ THIS IS THE ONLY STEP THAT SELLS ANYTHING, and it does it by showing
         the game rather than describing it. A real Mapbox map, on a city in the
         country they just picked, drawing a loop and counting the ground it
         encloses — the same three beats the app's own tutorial teaches
         (claim → raid → grow). Skippable in one tap, because a tutorial nobody
         can leave is a wall wearing a different hat. -->
    <div id="pane-learn" class="funnel-pane hidden">
      <h1 class="mt-6 font-display text-4xl font-bold leading-[1.05] tracking-tight">
        This is the <span class="text-gradient">game</span>.
      </h1>
      <p class="mt-4 text-[15px] leading-relaxed text-ink-soft">
        Thirty seconds, on a real map. Then we'll get you the app.
      </p>
      <GameTutorial />
    </div>

    <!-- ══════════════ STEP 3 · PLAN ══════════════
         Reached only with an account in hand, so every button here has exactly
         one runner to attach a payment to. -->
    <div id="pane-plan" class="funnel-pane hidden">
      <h1 class="mt-6 font-display text-4xl font-bold leading-[1.05] tracking-tight">
        You're in, <span class="text-gradient" id="plan-name">runner</span>.
      </h1>
      <p class="mt-4 text-[15px] leading-relaxed text-ink-soft">
        Your account is ready and your colour is saved. The game is free — Pro is for
        the runners who want every metre they earn to keep counting.
      </p>

      {/* ⚠️ AN IPHONE VISITOR IS TOLD THE BETTER ROUTE, AND NOT SOLD TO HERE.
          A web purchase is legal on iOS — guideline 3.1.3(b) permits an app to let
          users access a subscription "acquired… on other platforms or your web
          site, provided those items are also available as in-app purchases", which
          Pro is — and it already works: the entitlement is on the account and the
          app's `useIsPro()` reads it before it ever asks the store. But inside the
          app they pay with one Face ID tap and Apple owns the receipt, the renewal
          and the cancellation, which is genuinely better for them. So on iOS the
          store comes first and the plans sit below, still visible: hiding them
          would be a lie, and this pane is also what an iPad or a desktop Mac
          sees. */}
      <div id="plan-ios" class="hidden mt-6 rounded-2xl p-5" style="background:#DDE3E0">
        <p class="text-sm font-semibold text-ink">You're on an iPhone — Pro is one tap inside the app.</p>
        <p class="mt-2 text-sm leading-relaxed text-ink-faint">
          Install Terrarun, sign in with the email you just used, and subscribe with Face ID.
          Apple handles the receipt, the renewal and the cancellation.
        </p>
        <div class="mt-4"><AppStore compact={true} only="ios" /></div>
        <p class="mt-4 text-xs leading-relaxed text-ink-faint">
          You can still subscribe here if you prefer — it unlocks the same account on every device.
        </p>
      </div>

      {/* ⚠️ ON ANDROID THIS PAGE IS THE ONLY PLACE PRO CAN BE BOUGHT, so say so.
          The Android app has no Play Billing and links to no checkout — Google's
          External Payment Links Program would require Play Billing offered
          alongside, on a Google-rendered choice screen, and we have none to offer.
          The app therefore never steers anyone here; the website does its own
          selling, which is an ordinary web-to-app funnel. The one thing an Android
          runner needs and the iPhone branch above gives for free is the ORDER:
          pay first, install second, and sign in with this email — Pro is on the
          account, not on the phone. */}
      <div id="plan-android" class="hidden mt-6 rounded-2xl p-5" style="background:#DDE3E0">
        <p class="text-sm font-semibold text-ink">You're on Android — subscribe here, then install.</p>
        <p class="mt-2 text-sm leading-relaxed text-ink-faint">
          Pro lives on your account, not on your phone. Subscribe below, install Terrarun,
          and sign in with the email you just used — it will already be on. The game itself
          is free on Android either way; Pro removes the ads and keeps every metre counting.
        </p>
        <div class="mt-4"><AppStore compact={true} only="android" /></div>
      </div>
      {/* ⚠️ WHAT THEY JUST JOINED, BEFORE WHAT IT COSTS. A runner who came
          straight to /signup from an ad has never read the landing page, and the
          next thing this pane does is show them two prices. Three lines, the
          same three the landing page leads with, so the offer lands on somebody
          who knows what the game is. */}
      <ol class="mt-7 grid gap-3 text-sm" aria-label="How Terrarun works">
        <li class="flex items-start gap-3">
          <span class="step-number shrink-0">1</span>
          <span class="pt-1 text-ink-soft"><strong class="text-ink">Run a loop.</strong> Any route that closes back on itself — your block, a park, the long way home.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="step-number shrink-0">2</span>
          <span class="pt-1 text-ink-soft"><strong class="text-ink">The ground inside is yours.</strong> Measured in real m² and painted in your colour on everyone's map.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="step-number shrink-0">3</span>
          <span class="pt-1 text-ink-soft"><strong class="text-ink">Rivals come for it.</strong> Anyone who encloses your turf takes it. Run it back to take it again.</span>
        </li>
      </ol>

      {/* ⚠️ THIS IS A RECEIPT FOR A DECISION ALREADY MADE, not a new question.
          The country was chosen on the account step; this restates it next to
          the price it produced, because "billed from" is what somebody actually
          checks in the second before entering a card. Change writes through the
          same `__trSetCountry` seam the account field does — two controls, one
          value, so the label and the currency cannot drift apart.

          Passing that country into the checkout is what lets Paddle skip its
          first page. ⚠️ Not everywhere: the markets that need a ZIP/postal code
          for tax or banking compliance still ask for one, so the copy never
          promises a page count it cannot keep.

          ⚠️ AND THE METHODS ARE REAL. `availablePaymentMethods` comes from the
          price preview — Paddle's own answer for THIS country, not a row of
          logos we chose, and it changes when the country does. On a payment page
          run by a solo developer an invented trust signal is worse than none,
          and this one is free.

          ⚠️ IF UPI OR THE KOREAN METHODS ARE MISSING, IT IS NOT THIS CODE.
          Paddle supports UPI, KakaoPay, Naver Pay and PAYCO, and `METHOD_NAMES`
          below already knows their labels — but each has to be ticked in
          Paddle → Checkout → Checkout settings before the API returns it, which
          is exactly how Google Pay was absent from every market until it was
          enabled. The list here renders whatever Paddle sends, the moment it
          sends it. */}
      <div id="plan-billing" class="hidden mt-6 rounded-2xl p-4" style="background:#DDE3E0">
        <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
          <p class="text-sm text-ink-faint">
            Billed from <strong id="plan-country" class="text-ink">—</strong>
          </p>
          <button type="button" id="plan-country-change"
            class="text-sm font-semibold text-band-mid hover:underline">Change</button>
        </div>
        <label for="plan-country-select" class="sr-only">Your country</label>
        <select id="plan-country-select"
          class="well mt-3 hidden w-full px-3 py-2.5 text-[15px] text-ink outline-none"></select>
        <p id="plan-methods" class="mt-2 text-xs leading-relaxed text-ink-faint"></p>
      </div>

      <div id="plan-cards" class="mt-6 grid gap-4">
        <button type="button" id="plan-yearly" data-checkout={PRICE_YEARLY} disabled={!paddleReady}
          class="plan-key glass-mint plan-recommended p-6 text-left disabled:cursor-not-allowed disabled:opacity-60" style="--plan-delay:60ms">
          <span class="flex items-start justify-between gap-3">
            <span class="block">
              <span class="block font-mono text-xs uppercase tracking-widest text-white">Yearly</span>
              <span class="price-slot mt-2 block font-display text-3xl font-bold" data-price="yearly">{paddleReady ? '—' : 'Unavailable'}</span>
              <span class="mt-1 block text-sm text-white" data-permonth></span>
            </span>
            <span class="rounded-full px-2.5 py-1 text-[11px] font-bold" style="background:rgba(0,0,0,0.26);color:#5FF3C0" data-saving>Best value</span>
          </span>
          <span class="plan-go mt-5 flex items-center justify-between text-sm font-semibold text-white">
            Get Pro yearly <span aria-hidden="true" class="plan-arrow">→</span>
          </span>
        </button>

        <button type="button" id="plan-monthly" data-checkout={PRICE_MONTHLY} disabled={!paddleReady}
          class="plan-key glass p-6 text-left disabled:cursor-not-allowed disabled:opacity-60" style="--plan-delay:130ms">
          <span class="block">
            <span class="block font-mono text-xs uppercase tracking-widest text-ink-faint">Monthly</span>
            <span class="price-slot mt-2 block font-display text-3xl font-bold text-ink" data-price="monthly">{paddleReady ? '—' : 'Unavailable'}</span>
            <span class="mt-1 block text-sm text-ink-faint">Cancel any time.</span>
          </span>
          <span class="plan-go mt-5 flex items-center justify-between text-sm font-semibold text-band-mid">
            Get Pro monthly <span aria-hidden="true" class="plan-arrow">→</span>
          </span>
        </button>
      </div>

      <ul class="mt-5 grid gap-2 text-sm text-ink-soft">
        {proIncludes.map((line) => (
          <li class="flex items-start gap-2.5">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#046B4D" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <span>{line}</span>
          </li>
        ))}
      </ul>

      <p id="plan-error" class="hidden mt-5 rounded-xl px-4 py-3 text-sm" role="alert" aria-live="assertive" style="background:rgba(229,72,77,0.10);color:#A3282C"></p>

      {/* ⚠️ THE FREE DOOR IS A REAL DOOR, AND IT IS NOT HIDDEN. The app learned
          this the expensive way: 1.7 put the wall before the first run and
          activation fell from 56% to 5%. Nothing sells Pro to somebody with no
          ground to lose — the offer that works is the one the app makes after
          their first loop. This step exists because the website is the ONLY place
          an Android runner can buy at all, not because it should extract a card
          from a stranger. */}
      <button type="button" id="plan-skip" class="btn-ghost mt-6 w-full">Continue with the free game</button>
      <p class="mt-3 text-center text-xs leading-relaxed text-ink-faint">
        The whole game — running, claiming, stealing, clubs — is free. Pro never makes a run count for more territory.
      </p>

      <div class="trust-primer mt-8 grid gap-px overflow-hidden rounded-2xl bg-sunken sm:grid-cols-3" aria-label="Purchase safeguards">
        <div class="bg-canvas p-4">
          <p class="text-sm font-semibold text-ink">Paddle checkout</p>
          <p class="mt-1 text-xs leading-relaxed text-ink-faint">A regulated payment company takes the payment—not this page.</p>
        </div>
        <div class="bg-canvas p-4">
          <p class="text-sm font-semibold text-ink">No card data here</p>
          <p class="mt-1 text-xs leading-relaxed text-ink-faint">Your card details go directly to Paddle and never touch Terrarun’s servers.</p>
        </div>
        <div class="bg-canvas p-4">
          <p class="text-sm font-semibold text-ink">A way back</p>
          <p class="mt-1 text-xs leading-relaxed text-ink-faint"><a href="/refunds/" class="font-semibold text-band-mid hover:underline">Refunds</a> and direct human support, visible before you pay.</p>
        </div>
      </div>
    </div>

    <!-- ══════════════ ALREADY PRO ══════════════
         ⚠️ THE ONE GUARD THAT SAVES REAL MONEY. Somebody who subscribed on iPhone,
         or here last month, signing in again would otherwise be shown two buy
         buttons and could pay twice for the same account. A sentence in an FAQ is
         not a guard; this is. -->
    <div id="pane-pro" class="funnel-pane hidden">
      <div class="stamp mt-8 mx-auto flex h-16 w-16 items-center justify-center rounded-full"
        style="background:linear-gradient(180deg,#14D694,#059669 34%,#02513A);box-shadow:0 3px 6px rgba(15,23,20,0.22)">
        <svg class="stamp-check" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
      </div>
      <h1 class="mt-7 text-center font-display text-4xl font-bold leading-[1.05] tracking-tight">
        You already have <span class="text-gradient">Pro</span>.
      </h1>
      <p class="mt-4 text-center text-[15px] leading-relaxed text-ink-soft">
        This account is already subscribed, so there is nothing to buy here. Open the app
        and sign in with the same email — Pro is already on.
      </p>
      <div class="mt-8 flex justify-center [&_.as-cta]:items-center"><AppStore compact={true} /></div>
      <p class="mt-7 text-center text-sm text-ink-faint">
        Managing or cancelling? Use the link in your Paddle receipt, or email
        <a class="font-semibold text-band-mid hover:underline" href="mailto:support@striderunning.run">support@striderunning.run</a>.
      </p>
    </div>
  </section>

  <div id="signup-checkout-handoff" class="checkout-handoff hidden" role="status" aria-live="polite" aria-atomic="true">
    <span class="checkout-spinner" aria-hidden="true"></span>
    <span><strong data-checkout-title>Opening Paddle’s secure checkout…</strong><small data-checkout-copy>Your card details go directly to Paddle, not Terrarun.</small></span>
  </div>
</Layout>

<script>
  import {
    signUp, signIn, setProfile, usernameAvailable, remember, isPro, openCheckout,
    devicePlatform, HANDLE_RE, PALETTE, configured,
  } from '../lib/account';
  import { track, identify } from '../lib/analytics';

  const form = document.getElementById('signup-form') as HTMLFormElement | null;
  if (form && configured) {
    const err = document.getElementById('su-error')!;
    const submit = document.getElementById('su-submit') as HTMLButtonElement;
    const nameEl = document.getElementById('su-name') as HTMLInputElement;
    const hint = document.getElementById('su-name-hint')!;
    const paneAccount = document.getElementById('pane-account')!;
    const paneLearn = document.getElementById('pane-learn')!;
    const panePlan = document.getElementById('pane-plan')!;
    const panePro = document.getElementById('pane-pro')!;
    const progress = document.getElementById('su-progress')!;
    let colour = PALETTE[0];
    let mode: 'signup' | 'signin' = 'signup';
    let account: { userId: string; email: string } | null = null;
    /** Set the moment `signUp` returns, BEFORE the profile write that can fail.
     *  See the note at the retry below — this is what makes a second attempt
     *  possible at all. */
    let created: Awaited<ReturnType<typeof signUp>> | null = null;

    // ── the progress bar is ONE element, driven by a step number ──────────
    // ⚠️ COUNTED FROM THE MARKUP, never hardcoded. The step count has now been
    // wrong in two directions in this file's history; reading it off the nodes
    // that exist means adding a step to the DOM cannot leave the loop, the aria
    // label and the connectors disagreeing about how long the funnel is.
    const STEPS = progress.querySelectorAll('[data-node]').length;
    const setStep = (step: number) => {
      progress.dataset.step = String(step);
      progress.setAttribute('aria-label', `Progress: step ${step} of ${STEPS}`);
      for (let i = 1; i <= STEPS; i++) {
        const node = progress.querySelector(`[data-node="${i}"]`)!;
        const label = progress.querySelector(`[data-label="${i}"]`)!;
        node.classList.toggle('is-done', i < step);
        node.classList.toggle('is-current', i === step);
        node.textContent = i < step ? '✓' : String(i);
        // `step-label-away` is what collapses the other labels on a phone — see
        // the media query in global.css. Four names do not fit one row.
        label.className = i === step
          ? 'text-sm font-semibold text-ink'
          : `text-sm step-label-away ${i < step ? 'text-ink' : 'text-ink-faint'}`;
        const line = progress.querySelector(`[data-line="${i}"]`);
        if (line) line.classList.toggle('is-filled', step > i);
      }
    };

    // ⚠️ THE INLINE PADDLE CALLBACK CANNOT IMPORT, and it is the only thing that
    // learns whether a checkout completed, was abandoned or failed — the three
    // outcomes the funnel is actually about. Bridged on `window` rather than
    // duplicating a second capture path that would drift.
    (window as any).__trTrack = track;

    const showPane = (pane: HTMLElement, step: number) => {
      [paneAccount, paneLearn, panePlan, panePro].forEach((p) => p.classList.add('hidden'));
      pane.classList.remove('hidden');
      // Restart the entrance every time, so a second arrival still animates.
      pane.classList.remove('pane-in');
      void pane.offsetWidth;
      pane.classList.add('pane-in');
      setStep(step);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    // ── colour ────────────────────────────────────────────────────────────
    const swatches = Array.from(document.querySelectorAll<HTMLButtonElement>('.su-swatch'));
    const paint = () => swatches.forEach((s) => {
      const on = s.dataset.color === colour;
      // Selection is a DEBOSSED WELL, not a border — the app's one rule for
      // "chosen": depth is the state channel, colour is not.
      s.style.boxShadow = on
        ? 'inset 0 0 0 3px rgba(255,255,255,0.92), 0 0 0 2px rgba(15,23,20,0.28)'
        : 'inset 0 -2px 4px rgba(0,0,0,0.18)';
      s.style.transform = on ? 'scale(0.94)' : 'scale(1)';
    });
    swatches.forEach((s) => s.addEventListener('click', () => { colour = s.dataset.color!; paint(); }));
    paint();

    // ── name: normalise as they type, then check availability when they pause ──
    let checkTimer: number | undefined;
    nameEl.addEventListener('input', () => {
      // Same normalisation the app applies, so what they see here is what they get.
      const v = nameEl.value.toLowerCase().replace(/[^a-z0-9_]/g, '');
      if (v !== nameEl.value) nameEl.value = v;
      hint.textContent = '3–20 characters. This is how the city will know you.';
      hint.style.color = '';
      window.clearTimeout(checkTimer);
      if (!HANDLE_RE.test(v)) return;
      checkTimer = window.setTimeout(async () => {
        const free = await usernameAvailable(v);
        hint.textContent = free ? `${v} is free.` : `${v} is taken — try another.`;
        hint.style.color = free ? '#046B4D' : '#A3282C';
      }, 350);
    });

    // ── sign in instead ───────────────────────────────────────────────────
    document.getElementById('su-signin')!.addEventListener('click', () => {
      mode = mode === 'signup' ? 'signin' : 'signup';
      created = null; // a different mode is a different account

      const signingIn = mode === 'signin';
      submit.textContent = signingIn ? 'Sign in' : 'Create account';
      (document.getElementById('su-pass') as HTMLInputElement).autocomplete = signingIn ? 'current-password' : 'new-password';
      // The name and colour belong to an account that already has them.
      (document.getElementById('su-name-field') as HTMLElement).style.display = signingIn ? 'none' : '';
      (document.getElementById('su-colour-field') as HTMLElement).style.display = signingIn ? 'none' : '';
      (document.getElementById('su-signin') as HTMLElement).textContent = signingIn ? 'Create one instead' : 'Sign in instead';
    });

    const fail = (m: string) => {
      err.textContent = m;
      err.classList.remove('hidden');
      submit.disabled = false;
      submit.textContent = mode === 'signin' ? 'Sign in' : 'Create account';
    };

    // ── step 2 → step 3 ───────────────────────────────────────────────────
    // ⚠️ The tutorial is an inline island with no imports of its own, so the two
    // sides meet on `window`: it calls `tutorialDone` when the last act is
    // finished OR skipped, and the funnel decides what "done" leads to. Both
    // outcomes are tracked — a tutorial everyone skips and a tutorial everyone
    // watches are the same number of arrivals at the plan step.
    const toPlan = (via: 'tutorial' | 'skip' | 'direct') => {
      showPane(panePlan, 3);
      track('web_plan_view', { via });
    };
    (window as any).tutorialDone = (via: 'tutorial' | 'skip') => toPlan(via === 'skip' ? 'skip' : 'tutorial');

