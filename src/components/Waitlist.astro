---
// Pulls public Supabase creds at build time and hands them to the client script.
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---
<div class="mx-auto w-full max-w-md">
  <form id="waitlist-form" class="flex flex-col gap-3 sm:flex-row" novalidate>
    <label for="wl-email" class="sr-only">Email address</label>
    <input
      id="wl-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      inputmode="email"
      placeholder="you@email.com"
      class="min-w-0 flex-1 rounded-xl border border-white/12 bg-surface/70 px-4 py-3.5 text-ink placeholder:text-ink-faint outline-none transition focus:border-mint/60 focus:shadow-glow"
    />
    <button type="submit" id="wl-btn" class="btn-primary whitespace-nowrap">
      <span id="wl-btn-label">Get early access</span>
      <svg id="wl-spin" class="hidden h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-dasharray="40 60"/></svg>
    </button>
  </form>
  <p id="wl-msg" class="mt-3 min-h-[1.25rem] text-sm" role="status" aria-live="polite"></p>
</div>

<script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
  const form = document.getElementById('waitlist-form');
  const input = document.getElementById('wl-email');
  const btn = document.getElementById('wl-btn');
  const label = document.getElementById('wl-btn-label');
  const spin = document.getElementById('wl-spin');
  const msg = document.getElementById('wl-msg');

  const setMsg = (text, ok) => {
    msg.textContent = text;
    msg.style.color = ok === true ? '#06D6A0' : ok === false ? '#FCA5A5' : '#9CA3AF';
  };
  const loading = (on) => {
    btn.disabled = on;
    spin.classList.toggle('hidden', !on);
    label.textContent = on ? 'Joining…' : 'Get early access';
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (input.value || '').trim().toLowerCase();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setMsg('Please enter a valid email.', false); input.focus(); return; }
    if (!SUPABASE_URL || !SUPABASE_ANON_KEY) { setMsg('Waitlist isn’t configured yet — try again soon.', false); return; }

    loading(true);
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/waitlist`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          apikey: SUPABASE_ANON_KEY,
          Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
          Prefer: 'return=minimal',
        },
        body: JSON.stringify({ email, source: 'website' }),
      });
      if (res.ok) {
        form.reset();
        setMsg('You’re on the list. We’ll email you when Stride launches. 🟢', true);
      } else if (res.status === 409) {
        setMsg('You’re already on the list — see you at launch.', true);
      } else {
        setMsg('Something went wrong. Please try again.', false);
      }
    } catch {
      setMsg('Network error — check your connection and retry.', false);
    } finally {
      loading(false);
    }
  });
</script>
