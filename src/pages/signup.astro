    // are — reordering the DOM would move a button under a thumb already
    // travelling toward it, and this is the one page where a mis-tap costs money.
    const plat = devicePlatform();
    if (plat === 'ios') {
      document.getElementById('plan-ios')!.classList.remove('hidden');
    } else if (plat === 'android') {
      document.getElementById('plan-android')!.classList.remove('hidden');
    }

    const planError = document.getElementById('plan-error')!;
    const handoff = document.getElementById('signup-checkout-handoff');
    const checkoutFailed = () => {
      track('web_checkout_open_failed');
      handoff?.classList.add('hidden');
      planError.textContent = 'Secure checkout could not open — nothing was charged. Check any content blocker and try again, or email support@striderunning.run.';
      planError.classList.remove('hidden');
    };

    const buy = (priceId: string) => {
      if (!account || !priceId) return;
      track('web_checkout_opened', {
        plan: priceId === form.dataset.priceYearly ? 'yearly' : 'monthly',
        country: (window as any).__trCountry || null,
      });
      planError.classList.add('hidden');
      handoff?.classList.remove('hidden');
      openCheckout({
        priceId,
        userId: account.userId,
        email: account.email,
        // ⚠️ THE SAME COUNTRY THE PRICE ON SCREEN WAS CALCULATED FOR. The inline
        // bootstrapper publishes it after every PricePreview, including after the
        // runner changes it — passing anything else would open a checkout whose
        // currency disagrees with the card they just read.
        countryCode: (window as any).__trCountry || undefined,
        onError: checkoutFailed,
      });
    };

    document.querySelectorAll<HTMLButtonElement>('#plan-cards [data-checkout]').forEach((btn) => {
      btn.addEventListener('click', () => buy(btn.getAttribute('data-checkout') || ''));
    });
    document.getElementById('plan-skip')!.addEventListener('click', () => {
      // The single most important number on this page: how many reach the offer
      // and choose the free game. Without it, "the plan step converts badly" and
      // "the plan step works exactly as designed" look identical.
      track('web_free_chosen');
      location.href = '/welcome/?new=1';
    });

    // ── submit ────────────────────────────────────────────────────────────
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.classList.add('hidden');
      const email = (document.getElementById('su-email') as HTMLInputElement).value.trim();
      const password = (document.getElementById('su-pass') as HTMLInputElement).value;
      const username = nameEl.value.trim();

      if (!email || !password) return fail('Email and password are both needed.');
      if (mode === 'signup') {
        if (password.length < 8) return fail('Passwords need at least 8 characters.');
        if (!HANDLE_RE.test(username)) return fail('Runner name: 3–20 characters, lowercase letters, numbers and underscores.');
      }

      // ⚠️ A `?plan=` IS ONLY HONOURED IF IT IS ONE OF THIS BUILD'S OWN PRICES.
      // The value reaches Paddle, so an arbitrary id from a crafted link would
      // otherwise open a checkout for something we never meant to sell.
      const requestedPlan = new URLSearchParams(location.search).get('plan');
      const allowedPlans = [form.dataset.priceMonthly, form.dataset.priceYearly].filter(Boolean);
      const plan = requestedPlan && allowedPlans.includes(requestedPlan) ? requestedPlan : null;
      if (requestedPlan && !plan) return fail('That plan link is invalid or has expired. Return to Pricing and choose a current plan.');

      submit.disabled = true;
      submit.textContent = mode === 'signin' ? 'Signing in…' : 'Creating…';

      try {
        // ⚠️ THE ACCOUNT SURVIVES A FAILED SECOND HALF, SO THE RETRY MUST NOT
        // TRY TO CREATE IT AGAIN. `setProfile` can fail after `signUp` has
        // already succeeded — the runner name losing a race to the unique index
        // is exactly the case it catches, and it tells them to pick another one.
        // Without this, that retry calls signUp with an email that now exists,
        // GoTrue answers "User already registered", and somebody with a perfectly
        // good account is stranded on step one of their own funnel with no way
        // forward and no way to know why.
        // ⚠️ …but only for the SAME email. Editing the address between attempts
        // means a different account was intended, and reusing the created one
        // would quietly write this name and colour onto the first one.
        if (created && created.email.toLowerCase() !== email.toLowerCase()) created = null;
        const acc = created ?? (mode === 'signin' ? await signIn(email, password) : await signUp(email, password));
        if (mode === 'signup') { created = acc; await setProfile(acc, username, colour); }
        remember(acc);
        account = { userId: acc.userId, email: acc.email };
        // ⚠️ `users.id` is the SAME distinct_id the app calls `track.identify()`
        // with, which is what makes "signed up on the web, ran in the app" one
        // person in one funnel instead of two strangers.
        identify(acc.userId);
        track('web_account_created', { mode });

        // Somebody signing back in may already be subscribed — on iPhone, here,
        // or from a previous card. Never show them a buy button.
        if (mode === 'signin' && await isPro(acc.userId, acc.accessToken)) {
          showPane(panePro, STEPS);
          track('web_already_pro');
          return;
        }

        const nameSlot = document.getElementById('plan-name');
        if (nameSlot) nameSlot.textContent = mode === 'signup' ? username : (acc.email.split('@')[0] || 'runner');

        // ⚠️ THEY ALREADY CHOSE. Arriving with a `?plan=` means the decision was
        // made on the pricing page — teaching the game to somebody holding a
        // chosen plan is a step that can only lose them, so the tutorial is
        // skipped outright and the checkout opens over the plan pane, which is
        // what closing the overlay lands on.
        if (plan) {
          toPlan('direct');
          buy(plan);
          return;
        }

        // ⚠️ SIGNING IN IS NOT SIGNING UP. Somebody with an account has already
        // been through this page, or through the app's own tutorial, and being
        // taught the game again on the way to a price reads as a stall. The
        // lesson is for the runner who has just this second appeared.
        if (mode === 'signin') {
          toPlan('direct');
          return;
        }

        showPane(paneLearn, 2);
        track('web_tutorial_shown');
        // ⚠️ ONLY NOW. A Mapbox map built inside a `hidden` parent measures 0×0
        // and renders nothing at all — it has to be told the moment its pane
        // becomes visible, and this is the only place that knows.
        (window as any).startTutorial?.();
      } catch (e: any) {
        fail(e?.message || 'Something went wrong. Please try again.');
      }
    });
  }
</script>

{/* ══════════════ THE COUNTRY, AND WHO OWNS IT ══════════════
    ⚠️ THIS BLOCK IS NOT GATED ON PADDLE, DELIBERATELY. The country now does two
    jobs — it prices the plan step AND it chooses the city the tutorial's map
    flies to — and only one of those involves money. Gated on `paddleReady`, a
    build with a missing price id would ship an account form whose Country field
    said "Detecting…" forever, on a step that takes no payment at all.

    So the country lives here, in ONE seam (`__trSetCountry`), with two controls
    bound to it: the field on the account step and the Change control on the plan
    step. Two selects that each owned their own value is how a checkout ends up
    charging a currency the page never showed. */}
<script is:inline>
  (function () {
    var accSel = document.getElementById('su-country');
    var planSel = document.getElementById('plan-country-select');
    var planLabel = document.getElementById('plan-country');

    var regionNames = null;
    try { regionNames = new Intl.DisplayNames([navigator.language || 'en'], { type: 'region' }); } catch (e) { /* older browser */ }
    function countryName(code) {
      if (!code) return '';
      try { var n = regionNames && regionNames.of(code); if (n && n !== code) return n; } catch (e) { /* not a region */ }
      return code;
    }
    window.__trCountryName = countryName;

    // ⚠️ Codes come from ICU rather than a table that goes stale, and the names
    // arrive already localised. ~676 `DisplayNames.of` calls is a few
    // milliseconds — but it is a few milliseconds of the MAIN THREAD during
    // first paint, so it waits for idle. The field carries "Detecting…" until
    // then and the seam below re-applies whatever was chosen in the meantime.
    var CODES = null;
    function countryList() {
      if (CODES) return CODES;
      CODES = [];
      for (var a = 65; a <= 90; a++) {
        for (var b = 65; b <= 90; b++) {
          var code = String.fromCharCode(a) + String.fromCharCode(b);
          var name = countryName(code);
          if (name && name !== code) CODES.push([code, name]);
        }
      }
      CODES.sort(function (x, y) { return x[1].localeCompare(y[1]); });
      return CODES;
    }
    function fill(sel) {
      if (!sel || sel.dataset.filled) return;
      var frag = document.createDocumentFragment();
      // ⚠️ THE PLACEHOLDER STAYS. Without a leading empty option, a select filled
      // before any country has resolved displays the first entry alphabetically —
      // so the field would read "Afghanistan" while the price beside it was
      // computed for somewhere else, which is the exact drift this seam exists to
      // prevent. An empty value fails the seam's own test, so it can never be
      // submitted as a country either.
      var ph = document.createElement('option');
      ph.value = '';
      ph.textContent = 'Select your country';
      frag.appendChild(ph);
      countryList().forEach(function (pair) {
        var o = document.createElement('option');
        o.value = pair[0];
        o.textContent = pair[1];
        frag.appendChild(o);
      });
      sel.innerHTML = '';
      sel.appendChild(frag);
      sel.dataset.filled = '1';
      sel.value = window.__trCountry || '';
    }
    // The plan step's Change control builds its own copy on demand — 250 options
    // are a real cost on the page that decides whether somebody pays, and almost
    // nobody opens it.
    window.__trFillCountrySelect = fill;

    // Has a human chosen? A late geolocation answer must never overwrite that,
    // and the Paddle block reads it to decide whether its FIRST price preview
    // should ask about a country or let Paddle geolocate.
    window.__trCountryTouched = false;
    window.__trCountry = null;

    /**
     * The one place the country changes.
     *   source 'user'   — a select was used. Wins over everything after it.
     *   source 'detect' — Paddle geolocated, or the browser locale seeded it.
     *                     Ignored once a human has chosen.
     */
    window.__trSetCountry = function (code, source) {
      code = String(code || '').toUpperCase();
      // ⚠️ A REAL REGION, not merely two letters. `navigator.languages` can end
      // in things that look like a country and are not, and an invented code
      // reaches Paddle's PricePreview as a billing address — which fails the
      // whole preview and disables checkout, from a bad browser locale.
      // ⚠️ `regionNames &&` is load-bearing: without Intl.DisplayNames,
      // `countryName` returns the code it was given, so this test would reject
      // EVERY country and the funnel would price nothing at all.
      if (!/^[A-Z]{2}$/.test(code)) return;
      if (regionNames && countryName(code) === code) return;
      if (source === 'user') window.__trCountryTouched = true;
      else if (window.__trCountryTouched) return;
      if (code === window.__trCountry) return;

      window.__trCountry = code;
      if (accSel && accSel.dataset.filled) accSel.value = code;
      if (planSel && planSel.dataset.filled) planSel.value = code;
      if (planLabel) planLabel.textContent = countryName(code);
      // The map on step 2 flies to a city in this country.
      if (window.setTutorialCountry) window.setTutorialCountry(code);
      // ⚠️ THE PRICE MUST FOLLOW THE COUNTRY. Currency and tax both change with
      // it, so re-price rather than only relabelling — a card charged an amount
      // the page never showed is a chargeback. Registered by the Paddle block;
      // absent when checkout is not configured, which is not an error here.
      if (source === 'user' && window.__trReprice) window.__trReprice(code);
    };

    if (accSel) {
      accSel.addEventListener('change', function () {
        window.__trSetCountry(accSel.value, 'user');
      });
    }

    // The plan step's own Change control. It exists as well as the account
    // field because this is the last screen before a card is entered, and
    // "billed from the wrong country" is exactly the thing somebody notices
    // there — but it writes through the same seam, so the two can never hold
    // different answers.
    var changeBtn = document.getElementById('plan-country-change');
    if (changeBtn && planSel) {
      changeBtn.addEventListener('click', function () {
        fill(planSel);
        var opening = planSel.classList.contains('hidden');
        planSel.classList.toggle('hidden', !opening);
        changeBtn.textContent = opening ? 'Done' : 'Change';
        if (opening) planSel.focus();
      });
      planSel.addEventListener('change', function () {
        window.__trSetCountry(planSel.value, 'user');
      });
    }

    // Seed from the browser before any network answer, so the field is never
    // blank and the tutorial always has somewhere to be.
    (function seed() {
      var langs = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || '']);
      for (var i = 0; i < langs.length; i++) {
        var m = /-([A-Za-z]{2})$/.exec(String(langs[i]));
        if (m) { window.__trSetCountry(m[1], 'detect'); return; }
      }
      try {
        var r = new Intl.Locale(navigator.language || 'en').maximize().region;
        if (r) window.__trSetCountry(r, 'detect');
      } catch (e) { /* no Intl.Locale — Paddle's geolocation will answer */ }
    })();

    var idle = window.requestIdleCallback || function (fn) { return setTimeout(fn, 200); };
    idle(function () {
      // ⚠️ NO Intl.DisplayNames ⇒ NO LIST, and an empty <select> under a
      // "Country" label is worse than no field: it looks broken and it cannot be
      // answered. Hide it and let Paddle's geolocation decide, which is what
      // happened before this field existed.
      if (!countryList().length) {
        var field = document.getElementById('su-country-field');
        if (field) field.style.display = 'none';
        return;
      }
      fill(accSel);
    });
  })();
</script>

