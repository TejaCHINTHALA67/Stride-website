      var copy = handoff && handoff.querySelector('[data-checkout-copy]');

      function say(t, c, spinning) {
        if (!handoff) return;
        if (title) title.textContent = t;
        if (copy) copy.textContent = c;
        handoff.classList.toggle('is-done', !spinning);
        handoff.classList.remove('hidden');
      }
      function hide() { if (handoff) handoff.classList.add('hidden'); }

      function disablePlans(note) {
        document.querySelectorAll('[data-price]').forEach(function (el) { el.textContent = 'Unavailable'; });
        document.querySelectorAll('#plan-cards [data-checkout]').forEach(function (b) { b.disabled = true; });
        var e = document.getElementById('plan-error');
        if (e) { e.textContent = note; e.classList.remove('hidden'); }
      }

      // Paddle answers in machine names. Anything we do not have a name for is
      // title-cased rather than dropped — a new method should appear, not vanish.
      var METHOD_NAMES = {
        card: 'Cards', paypal: 'PayPal', apple_pay: 'Apple Pay', google_pay: 'Google Pay',
        samsung_pay: 'Samsung Pay', ideal: 'iDEAL', bancontact: 'Bancontact', alipay: 'Alipay',
        wechat_pay: 'WeChat Pay', blik: 'BLIK', mb_way: 'MB WAY', pix: 'Pix', upi: 'UPI',
