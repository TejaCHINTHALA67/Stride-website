          var key = li.price.id === PRICE_YEARLY ? 'yearly' : 'monthly';
          var el = document.querySelector('[data-price="' + key + '"]');
          if (el) {
            el.textContent = li.formattedTotals.total;
            el.classList.remove('is-loaded');
            void el.offsetWidth;
            el.classList.add('is-loaded');
          }
          raw[key] = Number(li.totals.total);
        });
        if (raw.monthly > 0 && raw.yearly > 0) {
          // ⚠️ Both are MINOR UNITS in the SAME currency, so the ratio needs no
          // decimal handling and is correct in every market.
          var pct = Math.round((1 - raw.yearly / (raw.monthly * 12)) * 100);
          var badge = document.querySelector('[data-saving]');
          if (badge) badge.textContent = pct > 0 ? 'Save ' + pct + '%' : 'Best value';
