---
import Layout from '../../layouts/Layout.astro';
import AppStore from '../../components/AppStore.astro';
import { cities } from '../../data/cities';

export function getStaticPaths() {
  return cities.map((c) => ({ params: { city: c.slug }, props: { city: c } }));
}

const { city } = Astro.props;
const title = `Run & Own ${city.name} — Running Game | Terrarun`;
const description = `Turn your runs in ${city.name} into a game. Claim the real area you enclose, steal rivals’ turf, and own your streets on a live map. Free GPS run tracker — download now on the App Store for iPhone.`;

const faqs = [
  {
    q: `Is there a running game for ${city.name}?`,
    a: `Yes — Terrarun is a GPS running game that works anywhere, including all of ${city.name}. Every loop you run claims the real area you enclose on a live map of the city, and other runners can steal it back. It’s live now on iPhone — download Terrarun from the App Store to play in ${city.name}.`,
  },
  {
    q: `Where are the best places to run in ${city.name}?`,
    a: `Popular spots include ${city.spots.map((s) => s.name).join(', ')}. In Terrarun, each of these is prime territory — run a loop and the area inside becomes yours.`,
  },
  {
    q: `Is Terrarun free to play in ${city.name}?`,
    a: `Yes. The full game — tracking, claiming territory, leaderboards and clubs — is free. An optional Terrarun Pro subscription adds extras, but you can own your part of ${city.name} without paying.`,
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout title={title} description={description} path={`/run/${city.slug}`}>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <!-- Hero -->
  <section class="mx-auto max-w-4xl px-5 pt-32 pb-10 text-center sm:pt-36">
    <a href="/run/" class="text-sm text-ink-faint transition hover:text-mint">← All cities</a>
    <p class="mt-6 font-mono text-xs uppercase tracking-[0.25em] text-mint">{city.country}</p>
    <h1 class="mt-3 font-display text-4xl font-bold leading-[1.05] tracking-tight sm:text-6xl">
      Run &amp; own <span class="text-gradient">{city.name}</span>.
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">{city.intro}</p>
    <p class="mx-auto mt-4 max-w-2xl text-ink-soft">
      Terrarun turns your runs in {city.name} into a territory game: every loop you run claims the real area you
      enclose on a live map — and rivals try to steal it back. <strong class="text-ink">The streets are
      unclaimed. For now.</strong>
    </p>
    <div class="mt-9 flex justify-center [&_.as-cta]:items-center [&_.as-social]:justify-center"><AppStore compact={false} /></div>
  </section>

  <!-- Best places to run -->
  <section class="reveal mx-auto max-w-4xl px-5 py-14">
    <h2 class="font-display text-2xl font-semibold sm:text-3xl">Best places to run in {city.name}</h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      In Terrarun, each of these is prime territory. Run a loop around one and the area inside becomes yours —
      painted your colour for the whole city to see.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {city.spots.map((s) => (
        <div class="glass rounded-2xl p-5">
          <h3 class="font-display text-lg font-semibold text-mint">{s.name}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{s.note}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- How it plays -->
  <section class="reveal mx-auto max-w-4xl px-5 py-14">
    <h2 class="font-display text-2xl font-semibold sm:text-3xl">How you claim {city.name}</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {[
        ['Run a loop, claim the area', `Close any loop on ${city.name}’s streets and the area inside becomes your territory on a live 3D map.`],
        ['Defend it — or lose it', 'Rivals can run over your turf and take it. That’s your reason to get out the door today.'],
        ['Top your city leaderboard', `Weekly leagues rank everyone in ${city.name} — climb to the top and become the runner who owns the most.`],
        ['Start a club war', `Rally a running club and fight live club-vs-club battles for ${city.name}’s neighbourhoods.`],
      ].map(([h, p]) => (
        <div class="glass rounded-2xl p-6">
          <h3 class="font-display text-lg font-semibold">{h}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{p}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="reveal mx-auto max-w-3xl px-5 py-14">
    <h2 class="font-display text-2xl font-semibold sm:text-3xl">Running in {city.name} — FAQ</h2>
    <div class="mt-8 space-y-3">
      {faqs.map((f) => (
        <details class="glass group rounded-2xl p-5">
          <summary class="cursor-pointer list-none font-display text-base font-semibold text-ink">{f.q}</summary>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="reveal mx-auto max-w-3xl px-5 pb-24 text-center">
    <div class="glass glass-mint rounded-3xl px-6 py-12">
      <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Claim {city.name} first.</h2>
      <p class="mx-auto mt-3 max-w-xl text-ink-soft">
        Terrarun is live on iPhone. Download it free from the App Store — the first runners in {city.name}
        take their neighbourhoods before anyone else shows up.
      </p>
      <div class="mt-8 flex justify-center [&_.as-cta]:items-center [&_.as-social]:justify-center"><AppStore compact={false} /></div>
      <p class="mt-6 text-sm text-ink-faint">
        New to running? <a href="/blog/couch-to-5k-beginners-guide/" class="text-mint hover:underline">Start with our couch-to-5K guide →</a>
      </p>
    </div>
  </section>
</Layout>
