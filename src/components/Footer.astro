---
const year = new Date().getFullYear();
---
<footer class="relative mt-24 border-t border-white/8">
  <div class="dot-grid pointer-events-none absolute inset-0 opacity-40"></div>
  <div class="relative mx-auto max-w-6xl px-5 py-14">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <div class="flex items-center gap-2.5">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-mint/15 ring-1 ring-mint/40">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" aria-hidden="true"><path d="M12 2l8.5 5v10L12 22l-8.5-5V7L12 2z" stroke="#06D6A0" stroke-width="1.6" stroke-linejoin="round"/></svg>
          </span>
          <span class="font-display text-lg font-semibold">Stride</span>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-ink-soft">
          Run & own your city. A competitive territory-running game for iOS.
        </p>
        <p class="mt-4 text-sm text-ink-faint">
          Questions? <a href="mailto:hello@striderunning.run" class="text-mint hover:underline">hello@striderunning.run</a>
        </p>
      </div>
      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3">
        <div>
          <h4 class="font-mono text-xs uppercase tracking-widest text-ink-faint">Product</h4>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/#how" class="text-ink-soft hover:text-ink">How it works</a></li>
            <li><a href="/#game" class="text-ink-soft hover:text-ink">The game</a></li>
            <li><a href="/#waitlist" class="text-ink-soft hover:text-ink">Waitlist</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-mono text-xs uppercase tracking-widest text-ink-faint">Legal</h4>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/privacy" class="text-ink-soft hover:text-ink">Privacy Policy</a></li>
            <li><a href="/terms" class="text-ink-soft hover:text-ink">Terms of Service</a></li>
            <li><a href="/disclaimer" class="text-ink-soft hover:text-ink">Disclaimer</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-mono text-xs uppercase tracking-widest text-ink-faint">Status</h4>
          <ul class="mt-3 space-y-2 text-sm">
            <li class="flex items-center gap-2 text-ink-soft"><span class="h-2 w-2 rounded-full bg-mint animate-pulse-glow"></span> iOS — in development</li>
            <li class="text-ink-faint">Android — later</li>
          </ul>
        </div>
      </div>
    </div>
    <div class="mt-12 flex flex-col gap-3 border-t border-white/8 pt-6 text-xs text-ink-faint sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Stride. All rights reserved.</p>
      <p>Made for runners. Run responsibly — eyes up, follow the rules of the road.</p>
    </div>
  </div>
</footer>
