# Cloudflare Pages headers — security + caching
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; font-src 'self' https://cdn.fontshare.com https://api.fontshare.com; style-src 'self' 'unsafe-inline' https://api.fontshare.com; script-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co; object-src 'none'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

# Universal links: Apple requires JSON content-type, no redirect, on this exact path
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600
