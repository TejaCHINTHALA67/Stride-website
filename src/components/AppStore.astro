---
/**
 * Store CTAs — Terrarun is LIVE on BOTH stores (Android approved 2026-07-30).
 *
 * ⚠️ THE VISITOR'S OWN STORE COMES FIRST. Both badges always render — the app is
 * genuinely on both and hiding one would be a lie — but a phone is handed its own
 * store at the front of the row, because "Download on the App Store" sitting first
 * on an Android phone is a dead end presented as the primary action. The ordering
 * is pure CSS off `html[data-platform]` (set once in Layout), so it costs no
 * layout pass and no script per instance.
 *
 * `only` is for the places that have already NAMED a platform in the copy beside
 * them — the iPhone notice on the plan step, for one. There, a second badge for
 * the other store is a contradiction, not a courtesy.
 */
const APP_STORE_URL = 'https://apps.apple.com/us/app/conquer-your-city-stride/id6776885395';
const PLAY_STORE_URL = 'https://play.google.com/store/apps/details?id=com.teja.stride';
interface Props { compact?: boolean; only?: 'ios' | 'android'; }
const { compact = false, only } = Astro.props as Props;
---
<div class="as-cta inline-flex flex-col items-start gap-4">
  <div class="as-row flex flex-wrap items-center gap-3">
  {only !== 'android' && (
  <a
    href={APP_STORE_URL}
    target="_blank"
    rel="noopener"
    aria-label="Download Terrarun on the App Store"
    class="as-badge as-badge-ios group inline-flex items-center gap-3 rounded-2xl border border-black/10 bg-black px-5 py-3.5 shadow-[0_10px_30px_-12px_rgba(0,0,0,0.9)] transition duration-300 hover:-translate-y-0.5 hover:border-black/25 hover:shadow-contact focus:outline-none focus-visible:ring-2 focus-visible:ring-band-accent"
  >
    <!-- Apple mark -->
    <svg viewBox="0 0 24 24" class="h-8 w-8 shrink-0" fill="#fff" aria-hidden="true">
      <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
    </svg>
    <span class="flex flex-col leading-none text-white">
      <span class="text-[11px] font-medium tracking-wide text-white/80">Download on the</span>
      <span class="mt-0.5 font-display text-xl font-semibold tracking-tight">App Store</span>
    </span>
  </a>
  )}

  {only !== 'ios' && (
  <a
    href={PLAY_STORE_URL}
    target="_blank"
    rel="noopener"
    aria-label="Get Terrarun on Google Play"
    class="as-badge as-badge-android group inline-flex items-center gap-3 rounded-2xl border border-black/10 bg-black px-5 py-3.5 shadow-[0_10px_30px_-12px_rgba(0,0,0,0.9)] transition duration-300 hover:-translate-y-0.5 hover:border-black/25 hover:shadow-contact focus:outline-none focus-visible:ring-2 focus-visible:ring-band-accent"
  >
    <!-- Google Play mark — the four-colour triangle -->
    <svg viewBox="0 0 24 24" class="h-8 w-8 shrink-0" aria-hidden="true">
      <path d="M3.6 2.4a1.2 1.2 0 0 0-.6 1.05v17.1a1.2 1.2 0 0 0 .6 1.05l9.05-9.6L3.6 2.4z" fill="#00D2FF" />
      <path d="M17.1 8.55 13.7 6.6 3.6 2.4c-.06-.03-.12-.05-.18-.07l9.23 9.67 4.45-3.45z" fill="#00E676" />
      <path d="m17.1 15.45-4.45-3.45 4.45-3.45 3.35 1.93c.86.5.86 1.54 0 2.04l-3.35 1.93z" fill="#FFCE00" />
      <path d="M3.42 21.67c.06-.02.12-.04.18-.07l10.1-4.2 3.4-1.95-4.45-3.45-9.23 9.67z" fill="#FF3A44" />
    </svg>
    <span class="flex flex-col leading-none text-white">
      <span class="text-[11px] font-medium tracking-wide text-white/80">GET IT ON</span>
      <span class="mt-0.5 font-display text-xl font-semibold tracking-tight">Google Play</span>
    </span>
  </a>
  )}
  </div>

  {!compact && (
    <div class="as-social flex items-center gap-3">
      <!-- runner avatar cluster -->
      <div class="flex -space-x-2.5" aria-hidden="true">
        {['#06D6A0', '#FBBF24', '#FF6B35', '#60A5FA', '#A78BFA'].map((c) => (
          <span
            class="grid h-8 w-8 place-items-center rounded-full ring-2 ring-canvas"
            style={`background: linear-gradient(145deg, ${c}33, ${c}14); border: 1px solid ${c}66;`}
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" aria-hidden="true">
              <circle cx="14.5" cy="5" r="2" fill={c} />
              <path d="M13.5 8.5 10 11l1.5 3.5L8 18.5 M13.5 8.5l3 2 3-1 M11.5 14.5l3 1 1 4" stroke={c} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        ))}
      </div>
      <p class="text-sm text-ink-soft">
        <span class="font-display font-semibold text-band-mid">Live now</span>
        <span> · Free on iPhone &amp; Android</span>
        <span class="ml-1 inline-block h-1.5 w-1.5 rounded-full bg-mint align-middle animate-pulse-glow" aria-hidden="true"></span>
      </p>
    </div>
  )}
</div>
