---
import Layout from '../layouts/Layout.astro';
import AppStore from '../components/AppStore.astro';
import Showcase from '../components/Showcase.astro';
import WorldGlobe from '../components/WorldGlobe.astro';

const steps = [
  { n: '01', t: 'Run a loop', d: 'Lace up and run any route that closes back on itself — your block, a park, your neighbourhood.', c: '#046B4D', image: '/images/how-loop.webp', alt: 'A carved city map with a runner completing a bright mint loop around a park.' },
  { n: '02', t: 'Claim the area', d: 'The real area your loop encloses becomes your territory on a live 3D map. Bigger loop, bigger turf.', c: '#9A6B00', image: '/images/how-claim.webp', alt: 'A raised mint territory claimed inside an irregular route loop, marked by a gold flag.' },
  { n: '03', t: 'Defend & conquer', d: 'Run over a rival’s turf to steal it. Get robbed? Run it back within 24h for a revenge bonus.', c: '#C6471B', image: '/images/how-defend.webp', alt: 'Mint and orange runners contesting the border between two carved city territories.' },
];

const features = [
  { t: 'Real territory, not hexes', d: 'Your turf is the actual shape you run, measured in m² with PostGIS precision and painted in your colour on everyone’s map.', span: 'sm:col-span-2', icon: 'M12 2l8.5 5v10L12 22l-8.5-5V7L12 2z' },
  { t: 'Steal & get stolen', d: 'Overlap a rival’s land and it’s yours. Loss-aversion that actually makes you lace up again.', icon: 'M4 20L20 4M6 4l4 4M14 16l4 4M4 4l3 1 1 3M20 20l-3-1-1-3' },
  { t: 'Shields & fair fights', d: 'New players and the freshly-robbed get protected. Small runners can’t be farmed by whales.', icon: 'M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z' },
  { t: 'Weekly leagues', d: 'Bronze → Diamond on territory gained. The ladder resets every Monday — anyone can win a week.', icon: 'M5 8h14l-2 8a4 4 0 01-4 3h-2a4 4 0 01-4-3L5 8zM8 8V6a4 4 0 018 0v2' },
  { t: 'Plant your flag', d: 'Equip a flag and it waves on your turf with your name — tap any rival’s to size them up.', span: 'sm:col-span-2', icon: 'M6 3v18M6 4h11l-3 4 3 4H6' },
  { t: 'Live 3D war map', d: 'Tilted, building-extruded, neon territories. Your city has never looked like this.', icon: 'M3 7l6-3 6 3 6-3v13l-6 3-6-3-6 3V7zM9 4v13M15 7v13' },
];

// THE PLAYBOOK — genuinely useful: how to actually win your first week.
const plays = [
  {
    k: 'SHAPE', t: 'Loops beat lines — always', c: '#06D6A0',
    d: 'A 500 m out-and-back encloses ~0 m². The same 500 m around a block captures the whole block. Never retrace your steps — make a shape.',
    stat: '875 m²', statLabel: 'a small park loop',
    vs: '78 m²', vsLabel: 'same distance out-and-back',
  },
  {
    k: 'TIMING', t: 'Strike when the board resets', c: '#FBBF24',
    d: 'Leagues rank territory GAINED each week and reset every Monday. A big Monday loop puts you on top of your division while everyone else sleeps in.',
    stat: 'Mon 00:00', statLabel: 'weekly league reset',
    vs: '24 h', vsLabel: 'revenge-bonus window',
  },
  {
    k: 'DEFENSE', t: 'Re-run your own turf', c: '#FF6B35',
    d: 'Anything a rival encloses, they take. Re-running your area re-claims the overlap and shows attackers your flag is active. Stale turf is free turf.',
    stat: '+50 XP', statLabel: 'revenge reclaim bonus',
    vs: '3 days', vsLabel: 'new-player shield',
  },
];

const faqs = [
  { q: 'What is Terrarun?', a: 'Terrarun is a competitive territory-running game for iOS. You run a loop outdoors and the real-world area your route encloses becomes your territory on a shared, live 3D map — you can steal rivals’ territory, defend your own, and climb weekly leagues.' },
  { q: 'Is Terrarun available now?', a: 'Yes — Terrarun is live on the App Store for iPhone and on Google Play for Android. Download it free, pick your colour, and claim your first block today.' },
  { q: 'How do you actually “own” territory?', a: 'When your GPS route closes into a loop, the area it encloses is captured as a polygon and becomes yours on the shared map. Other runners can take it by enclosing it themselves, and you can take theirs.' },
  { q: 'Is it free?', a: 'Yes. Terrarun is free to play. Android is supported by ads; optional Terrarun Pro removes them and unlocks the full map, route planning and deeper analytics. Pro never makes a run count for more territory.' },
  { q: 'What stops cheaters in cars?', a: 'Every run goes through anti-cheat: physics checks on speed, GPS quality and movement patterns, plus a second-pass automatic review. Vehicle-speed runs are saved as workouts only — no territory, no XP.' },
  { q: 'Do I need to share my location?', a: 'Terrarun needs GPS while you run to track your route, like any running app. You control privacy settings, and you can run in explore mode without claiming. See our Privacy Policy.' },
  { q: 'Is there an Android version?', a: 'Yes. Terrarun is live on Google Play for Android, and on the App Store for iPhone. Both are free to download.' },
  { q: 'What makes Terrarun different from other running apps?', a: 'Most running apps just log a run and hand you stats. Terrarun turns running into a competitive game: the real area you enclose on a loop becomes territory you own on a shared live map, you steal and defend turf against real rivals, and you climb tiers and weekly leagues. It’s a run tracker with a scoreboard — built for people who want a reason to lace up, not just another step counter.' },
  { q: 'Is Terrarun a good alternative to Strava?', a: 'If you love the social, competitive side of running but find leaderboards and segments stale, Terrarun is built for you. You still get GPS tracking, splits, pace, distance and a full run history like any serious running app — plus a live territory war, flags, leagues and steal/defend mechanics that give every run real stakes. Many runners use Terrarun alongside their existing tracker.' },
  { q: 'Is Terrarun a real GPS run tracker?', a: 'Yes. Terrarun records your route with GPS, shows pace, distance, splits and elevation, keeps a full run history, and (on supported devices) reads heart rate and calories from Apple Health. The territory game is layered on top of a proper, accurate run tracker.' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />

  <!-- HERO -->
  <section class="relative overflow-hidden pt-28 sm:pt-36">
    <div class="dot-grid pointer-events-none absolute inset-0 opacity-50 [mask-image:radial-gradient(ellipse_at_top,black,transparent_75%)]"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <div class="reveal flex items-center gap-2 text-sm font-medium text-band-mid">
          <span class="h-2 w-2 rounded-full bg-mint animate-pulse-glow"></span>
          <span class="uppercase tracking-[0.18em] text-xs">Live on the App Store &amp; Google Play</span>
        </div>
        <h1 class="reveal mt-6 font-display text-5xl font-bold leading-[0.95] tracking-tight sm:text-6xl lg:text-7xl" style="animation-delay:.05s">
          Run a loop.<br /><span class="text-gradient">Own the block.</span>
        </h1>
        <p class="reveal mt-6 max-w-md text-lg leading-relaxed text-ink-soft" style="animation-delay:.12s">
          Terrarun turns your city into a turf war. The area you enclose on a run becomes your territory. Claim it, defend it, and steal your rivals’ on a living 3D map.
        </p>
        {/* ⚠️ THE HERO ASKS FOR ONE THING: THE DOWNLOAD. The primary button used
            to be "Start claiming ground" pointing at /pricing — a request for
            money from somebody who has not run a metre, sitting directly above
            the words "Free to play". It also competed with the store badges
            three centimetres below it, so the page had two primary actions
            saying different things.

            This is the same lesson the app itself learned the hard way: 1.7 put
            the paywall before the first run and activation fell from 56% to 5%.
            Nothing sells Pro before somebody has ground worth defending. The
            price is one click away in the nav for anyone who came looking. */}
        {/* ⚠️ THE PRIMARY ASKS FOR AN ACCOUNT, NOT A PAYMENT. It used to say
            "Start claiming ground" and point at /pricing — a request for money
            from somebody who has not run a metre, sitting directly above the
            words "Free to play". Removing it outright was the other mistake:
            that left the page with no way in at all, just two store badges.

            Creating an account is free, takes a minute, and is the step that
            actually starts the funnel — it captures the email, works across web,
            iPhone and Android, and means the app has something to sign into
            rather than a cold start. The price is one click away in the nav for
            anyone who came looking for it. */}
        <div class="reveal mt-8 flex flex-wrap items-center gap-3" style="animation-delay:.18s">
          <a href="/signup/" class="btn-primary">Get started — it's free</a>
          <a href="#how" class="btn-ghost">See how it works</a>
        </div>
        {/* Straight to the store for anyone who does not want an account first.
            The funnel is the recommendation, never a toll gate. */}
        <div class="reveal mt-7" id="download-top" style="animation-delay:.24s">
          <p class="mb-3 font-mono text-[11px] uppercase tracking-widest text-ink-faint">Or just get the app — free to play</p>
          <AppStore />
        </div>

        {/* ⚠️ REAL NUMBERS, PULLED FROM THE LIVE DATABASE — never a rating badge.
            The App Store average is 4.7 from THREE ratings; printing a star score
            off a sample that small is a claim we cannot stand behind, and it is
            exactly the kind of thing a merchant of record drops an account for.
            Ground actually claimed is both true and a better argument. */}
        <dl class="reveal mt-9 grid grid-cols-3 gap-px overflow-hidden rounded-xl bg-sunken" style="animation-delay:.28s">
          <div class="bg-canvas px-4 py-4">
            <dt class="font-mono text-[10px] uppercase tracking-widest text-ink-faint">Ground claimed</dt>
            <dd class="mt-1 font-display text-2xl font-bold text-ink" id="stat-km2">—</dd>
          </div>
          <div class="bg-canvas px-4 py-4">
            <dt class="font-mono text-[10px] uppercase tracking-widest text-ink-faint">Runners</dt>
            <dd class="mt-1 font-display text-2xl font-bold text-ink">680+</dd>
          </div>
          <div class="bg-canvas px-4 py-4">
            <dt class="font-mono text-[10px] uppercase tracking-widest text-ink-faint">Territories</dt>
            <dd class="mt-1 font-display text-2xl font-bold text-ink" id="stat-territories">—</dd>
          </div>
        </dl>
      </div>

      {/* THE WORLD, TURNING. Real territory from the live database landing one
          claim at a time — the one thing on this site nobody else can copy,
          because it is not an illustration. */}
      <div class="reveal mx-auto w-full max-w-[460px]" style="animation-delay:.3s">
        <WorldGlobe />
        <figure class="hero-photo glass mt-5 overflow-hidden p-2">
          <div class="relative overflow-hidden rounded-[14px]">
            <img src="/images/runner-dawn.webp" width="1536" height="1024"
              alt="A runner rounding a quiet city block at dawn."
              fetchpriority="high" decoding="async" class="aspect-[3/2] w-full object-cover" />
            <figcaption class="absolute inset-x-3 bottom-3 rounded-xl px-3 py-2 text-xs font-medium text-white"
              style="background:rgba(3,80,58,.90)">
              The city is the board. Your run is the move.
            </figcaption>
          </div>
        </figure>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how" class="relative mx-auto max-w-6xl px-5 pt-28">
    <div class="reveal max-w-xl">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-band-mid">How it works</p>
      <h2 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">Three moves. The whole city.</h2>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {steps.map((s, i) => (
        <div class="reveal group relative overflow-hidden rounded-2xl glass p-3 transition-transform duration-300 hover:-translate-y-1" style={`animation-delay:${i * 0.08}s`}>
          <img src={s.image} alt={s.alt} width="1200" height="1200" loading="lazy" decoding="async"
            class="aspect-square w-full rounded-[14px] object-cover" />
          <div class="p-4">
          <div class="font-mono text-sm font-semibold" style={`color:${s.c}`}>{s.n}</div>
          <h3 class="mt-3 font-display text-2xl font-semibold">{s.t}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{s.d}</p>
          <div class="mt-6 h-1 w-full rounded-full bg-sunken">
            <div class="h-1 rounded-full transition-all duration-700 group-hover:w-full" style={`width:34%;background:${s.c}`}></div>
          </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- SEE IT IN ACTION — real app screenshots -->
  <Showcase />

  <!-- THE GAME (bento) -->
  <section id="game" class="relative mx-auto max-w-6xl px-5 pt-28">
    <div class="reveal max-w-xl">
      <p class="font-mono text-xs uppercase tracking-[0.2em]" style="color:#A83D18">The game</p>
      <h2 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">A running app with a <span class="text-gradient">scoreboard</span>.</h2>
      <p class="mt-4 text-ink-soft">Not another step counter. A hard, skill-based territory game where every run changes the map.</p>
    </div>
    <div class="mt-12 grid auto-rows-[1fr] gap-5 sm:grid-cols-3">
      {features.map((f, i) => (
        <div class={`reveal rounded-2xl glass p-6 transition-transform duration-300 hover:-translate-y-1 ${f.span ?? ''}`} style={`animation-delay:${i * 0.06}s`}>
          <div class="grid h-10 w-10 place-items-center rounded-xl bg-mint/8 ring-1 ring-mint/25">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true"><path d={f.icon} stroke="#06D6A0" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3 class="mt-4 font-display text-xl font-semibold">{f.t}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{f.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- THE PLAYBOOK — actually useful tactics -->
  <section id="playbook" class="relative mx-auto max-w-6xl px-5 pt-28">
    <div class="reveal max-w-xl">
      <p class="font-mono text-xs uppercase tracking-[0.2em]" style="color:#765500">The playbook</p>
      <h2 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">Win your first week.</h2>
      <p class="mt-4 text-ink-soft">Territory is a skill game. These three habits separate block-owners from joggers — learn them before your first run.</p>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {plays.map((p, i) => (
        <div class="reveal flex flex-col rounded-2xl glass p-7 transition-transform duration-300 hover:-translate-y-1" style={`animation-delay:${i * 0.08}s`}>
          <div class="font-mono text-[11px] uppercase tracking-[0.22em]" style={`color:${p.c}`}>{p.k}</div>
          <h3 class="mt-3 font-display text-2xl font-semibold leading-snug">{p.t}</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft">{p.d}</p>
          <div class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-sunken">
            <div class="bg-canvas/70 p-3.5">
              <div class="font-display text-lg font-semibold" style={`color:${p.c}`}>{p.stat}</div>
              <div class="mt-0.5 text-[11px] leading-tight text-ink-faint">{p.statLabel}</div>
            </div>
            <div class="bg-canvas/70 p-3.5">
              <div class="font-display text-lg font-semibold text-ink-soft">{p.vs}</div>
              <div class="mt-0.5 text-[11px] leading-tight text-ink-faint">{p.vsLabel}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- STAT TEASE -->
  <section class="relative mx-auto max-w-6xl px-5 pt-28">
    <div class="reveal grid gap-px overflow-hidden rounded-2xl glass ring-grad sm:grid-cols-3">
      {[
        { v: 'Every loop', s: 'measured to the metre, in m²' },
        { v: '12 tiers + leagues', s: 'climb from Rookie to Titan' },
        { v: 'One shared map', s: 'one city, one war' },
      ].map((x) => (
        <div class="bg-canvas/40 p-8 text-center">
          <div class="font-display text-3xl font-bold text-band-mid sm:text-4xl">{x.v}</div>
          <div class="mt-1 text-sm text-ink-soft">{x.s}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="relative mx-auto max-w-3xl px-5 pt-28">
    <div class="reveal text-center">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-band-mid">FAQ</p>
      <h2 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">Good questions.</h2>
    </div>
    <div class="mt-10 divide-y divide-white/8 overflow-hidden rounded-2xl glass">
      {faqs.map((f) => (
        <details class="group px-6 py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-medium marker:hidden">
            {f.q}
            <span class="text-ink-faint transition group-open:rotate-45 group-open:text-band-mid">+</span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- FINAL CTA -->
  <section id="download" class="relative mx-auto max-w-4xl px-5 pt-28">
    <div class="reveal relative overflow-hidden rounded-[2rem] glass glass-mint px-6 py-16 text-center sm:px-12">
      <div class="dot-grid pointer-events-none absolute inset-0 opacity-30"></div>
      <div class="relative">
        <h2 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Claim your city.</h2>
        <p class="mx-auto mt-4 max-w-md text-ink-soft">Terrarun is live. Download it free, run your first loop, and take your block before your rivals do.</p>
        <div class="mt-8 flex justify-center [&_.as-cta]:items-center [&_.as-social]:justify-center"><AppStore /></div>
      </div>
    </div>
  </section>

</Layout>
