---
// Premium "see every screen" showcase — a scroll-snap carousel of the real
// App Store screenshots (already caption-baked marketing shots). Arrows + dots
// + drag + gentle auto-advance (all reduced-motion aware) and scroll-reveal.
const shots = [
  { src: '/shots/01.jpg', n: '01', label: 'The living 3D map', alt: 'Stride app map screen — your running territory painted mint across a tilted 3D map of Manhattan with rival territories in orange and pink.' },
  { src: '/shots/02.jpg', n: '02', label: 'Start a run', alt: 'Stride pre-run screen showing 3.20 km² of territory, a 128-day streak, run modes and a big START button.' },
  { src: '/shots/03.jpg', n: '03', label: 'Real GPS tracking', alt: 'Stride run summary with distance, time, average pace, elevation and a per-kilometre split chart.' },
  { src: '/shots/04.jpg', n: '04', label: 'Steal & defend turf', alt: 'Stride 3D war map where a rival is stealing territory, shown as a shrinking mint area with a yellow contested block.' },
  { src: '/shots/05.jpg', n: '05', label: 'Weekly leagues', alt: 'Stride ranks screen with a Titan tier badge and a global leaderboard of runners ranked by territory in km².' },
  { src: '/shots/06.jpg', n: '06', label: 'Social feed', alt: 'Stride community feed with a shared run, kudos, comments, a challenge button and a live event card.' },
  { src: '/shots/07.jpg', n: '07', label: 'Run clubs', alt: 'Stride clubs list with run clubs, their combined territory in km² and member counts for club-vs-club battles.' },
  { src: '/shots/08.jpg', n: '08', label: 'Turf wars & events', alt: 'Stride events tab showing live and upcoming area-blitz turf war races you can join.' },
  { src: '/shots/09.jpg', n: '09', label: 'Deep analytics', alt: 'Stride analytics with a 30-day distance trend line, a consistency ring, weekly totals and best-effort insights.' },
  { src: '/shots/10.jpg', n: '10', label: 'Level up', alt: 'Stride profile with a hex avatar, Titan rank, 128-day streak, XP bar, followers and weekly activity.' },
];
---
<section id="screens" class="relative mx-auto max-w-6xl px-5 pt-28">
  <div class="reveal max-w-xl">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-mint">See it in action</p>
    <h2 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">Every screen, built to make you <span class="text-gradient">run</span>.</h2>
    <p class="mt-4 text-ink-soft">Swipe through the real app — the living map, the run, the leagues, the clubs and the turf wars.</p>
  </div>

  <div class="sc relative mt-12">
    <!-- track -->
    <div class="sc-track flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth pb-6 sm:gap-6">
      {shots.map((s, i) => (
        <figure
          class="sc-card reveal snap-start shrink-0"
          style={`animation-delay:${Math.min(i, 5) * 0.06}s`}
        >
          <div class="sc-frame group relative overflow-hidden rounded-[1.9rem] border border-white/10 bg-surface/40 shadow-[0_24px_60px_-24px_rgba(0,0,0,0.85)] ring-1 ring-white/5 transition duration-500 hover:-translate-y-1.5 hover:border-mint/30 hover:shadow-glow">
            <img
              src={s.src}
              alt={s.alt}
              width="760"
              height="1651"
              loading="lazy"
              decoding="async"
              class="block h-auto w-full select-none"
              draggable="false"
            />
            <div class="pointer-events-none absolute inset-0 rounded-[1.9rem] ring-1 ring-inset ring-white/10"></div>
          </div>
          <figcaption class="mt-4 flex items-center gap-3">
            <span class="grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-mint/10 font-mono text-[11px] font-semibold text-mint ring-1 ring-mint/25">{s.n}</span>
            <span class="font-display text-base font-semibold text-ink">{s.label}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- arrows (desktop) -->
    <button type="button" class="sc-prev group absolute -left-3 top-[42%] z-10 hidden h-11 w-11 -translate-y-1/2 place-items-center rounded-full glass ring-1 ring-white/10 transition hover:border-mint/40 hover:shadow-glow disabled:opacity-30 lg:grid" aria-label="Previous screen">
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button type="button" class="sc-next group absolute -right-3 top-[42%] z-10 hidden h-11 w-11 -translate-y-1/2 place-items-center rounded-full glass ring-1 ring-white/10 transition hover:border-mint/40 hover:shadow-glow disabled:opacity-30 lg:grid" aria-label="Next screen">
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <!-- dots -->
    <div class="sc-dots mt-2 flex flex-wrap justify-center gap-2" role="tablist" aria-label="Screen navigation">
      {shots.map((s, i) => (
        <button type="button" class="sc-dot h-2 w-2 rounded-full bg-white/20 transition-all duration-300 hover:bg-white/40" data-i={i} aria-label={`Go to ${s.label}`}></button>
      ))}
    </div>
  </div>
</section>

<style>
  .sc-track { scrollbar-width: none; -ms-overflow-style: none; }
  .sc-track::-webkit-scrollbar { display: none; }
  .sc-card { width: clamp(232px, 74vw, 300px); }
  .sc-frame img { -webkit-user-drag: none; }
  .sc-dot.is-active { width: 1.5rem; background: #06D6A0; box-shadow: 0 0 12px rgba(6,214,160,0.7); }
  @media (prefers-reduced-motion: reduce) {
    .sc-track { scroll-behavior: auto; }
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById('screens');
    if (!root) return;
    const track = root.querySelector('.sc-track');
    const cards = Array.from(root.querySelectorAll('.sc-card'));
    const dots = Array.from(root.querySelectorAll('.sc-dot'));
    const prev = root.querySelector('.sc-prev');
    const next = root.querySelector('.sc-next');
    if (!track || !cards.length) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const atEnd = () => track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;

    // Snap-start: bring a card's left edge to the track's left edge.
    const activeIndex = () => {
      if (atEnd()) return cards.length - 1;
      let best = 0, bestD = Infinity;
      cards.forEach((c, i) => {
        const d = Math.abs(c.offsetLeft - track.scrollLeft);
        if (d < bestD) { bestD = d; best = i; }
      });
      return best;
    };

    const go = (i, smooth = true) => {
      const idx = Math.max(0, Math.min(cards.length - 1, i));
      track.scrollTo({ left: cards[idx].offsetLeft, behavior: smooth && !reduced ? 'smooth' : 'auto' });
    };

    const paint = () => {
      const a = activeIndex();
      dots.forEach((d, i) => d.classList.toggle('is-active', i === a));
      if (prev) prev.disabled = a === 0;
      if (next) next.disabled = a === cards.length - 1;
    };

    prev && prev.addEventListener('click', () => { stop(); go(activeIndex() - 1); });
    next && next.addEventListener('click', () => { stop(); go(activeIndex() + 1); });
    dots.forEach((d) => d.addEventListener('click', () => { stop(); go(+d.dataset.i); }));

    let raf = 0;
    track.addEventListener('scroll', () => {
      if (raf) return;
      raf = requestAnimationFrame(() => { raf = 0; paint(); });
    }, { passive: true });

    // Drag-to-scroll (desktop mouse); native touch handles mobile.
    let down = false, startX = 0, startL = 0, moved = false;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') return;
      down = true; moved = false; startX = e.clientX; startL = track.scrollLeft;
      track.style.cursor = 'grabbing';
    });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 4) { moved = true; stop(); }
      track.scrollLeft = startL - dx;
    });
    window.addEventListener('pointerup', () => {
      if (!down) return;
      down = false; track.style.cursor = '';
      if (moved) go(activeIndex()); // snap to nearest
    });

    // Gentle auto-advance until first interaction (skip if reduced motion).
    let timer = 0;
    const stop = () => { if (timer) { clearInterval(timer); timer = 0; } };
    if (!reduced) {
      timer = setInterval(() => {
        const a = activeIndex();
        go(a >= cards.length - 1 ? 0 : a + 1);
      }, 3800);
      ['wheel', 'touchstart', 'pointerdown', 'keydown'].forEach((ev) =>
        track.addEventListener(ev, stop, { passive: true }));
      document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });
    }

    go(0, false);
    paint();
  })();
</script>
