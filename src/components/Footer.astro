---
const year = new Date().getFullYear();
---
<footer class="relative mt-24 border-t border-ink/10">
  <div class="dot-grid pointer-events-none absolute inset-0 opacity-40"></div>
  <div class="relative mx-auto max-w-6xl px-5 py-14">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <div class="flex items-center gap-2.5">
          <img src="/stride-logo.png" alt="Terrarun" width="36" height="36" class="h-9 w-9 rounded-lg" />
          <span class="font-display text-lg font-semibold">Terrarun</span>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-ink-soft">
          Run & own your city. A competitive territory-running game for iPhone and Android.
        </p>
        <p class="mt-4 text-sm text-ink-faint">
          Questions? <a href="mailto:hello@striderunning.run" class="text-band-mid hover:underline">hello@striderunning.run</a>
        </p>
      </div>
      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3">
        <div>
          <h4 class="font-mono text-xs uppercase tracking-widest text-ink-faint">Product</h4>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/pricing/" class="text-ink-soft hover:text-ink">Pricing</a></li>
            <li><a href="/#how" class="text-ink-soft hover:text-ink">How it works</a></li>
            <li><a href="/#screens" class="text-ink-soft hover:text-ink">Screens</a></li>
            <li><a href="/#game" class="text-ink-soft hover:text-ink">The game</a></li>
            <li><a href="https://apps.apple.com/us/app/conquer-your-city-stride/id6776885395" target="_blank" rel="noopener" class="text-ink-soft hover:text-ink">Download on iOS</a></li>
            <li><a href="https://play.google.com/store/apps/details?id=com.teja.stride" target="_blank" rel="noopener" class="text-ink-soft hover:text-ink">Get it on Google Play</a></li>
            <li><a href="/run/" class="text-ink-soft hover:text-ink">Run your city</a></li>
            <li><a href="/strava-alternative/" class="text-ink-soft hover:text-ink">Strava alternative</a></li>
            <li><a href="/blog/" class="text-ink-soft hover:text-ink">Blog</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-mono text-xs uppercase tracking-widest text-ink-faint">Legal</h4>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/privacy/" class="text-ink-soft hover:text-ink">Privacy Policy</a></li>
            {/* ⚠️ Consent that cannot be withdrawn is not consent. This reopens
                the first-layer choice — not a pre-ticked panel. */}
            <li><a href="/privacy/#cookies" data-cookie-settings class="text-ink-soft hover:text-ink">Cookie settings</a></li>
            <li><a href="/refunds/" class="text-ink-soft hover:text-ink">Refund Policy</a></li>
            <li><a href="/security/" class="text-ink-soft hover:text-ink">Security</a></li>
            <li><a href="/terms/" class="text-ink-soft hover:text-ink">Terms of Service</a></li>
            <li><a href="/disclaimer/" class="text-ink-soft hover:text-ink">Disclaimer</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-mono text-xs uppercase tracking-widest text-ink-faint">Status</h4>
          <ul class="mt-3 space-y-2 text-sm">
            <li class="flex items-center gap-2 text-ink-soft"><span class="h-2 w-2 rounded-full bg-mint"></span> iOS — live on the App Store</li>
            <li class="flex items-center gap-2 text-ink-soft"><span class="h-2 w-2 rounded-full bg-mint"></span> Android — live on Google Play</li>
          </ul>
        </div>
      </div>
    </div>
    <div class="mt-12 flex flex-col gap-3 border-t border-ink/10 pt-6 text-xs text-ink-faint sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Terrarun. All rights reserved.</p>
      <p>Made for runners. Run responsibly — eyes up, follow the rules of the road.</p>
    </div>
  </div>
</footer>
